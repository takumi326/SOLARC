#!/usr/bin/env bash
# Production Docker boot:
# 1. Show cute startup page on $PORT immediately (before Rails is ready).
# 2. Warm-boot Puma on an internal port until /up succeeds.
# 3. Hand off to Puma on $PORT for normal traffic.
#
# DB migration runs in Render preDeployCommand (bin/render-release), not here.
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-3000}"
INTERNAL_PORT="${INTERNAL_PORT:-9292}"

bin/serve-startup "$PORT" &
STARTUP_PID=$!

stop_startup() {
  kill "$STARTUP_PID" 2>/dev/null || true
  wait "$STARTUP_PID" 2>/dev/null || true
}
trap stop_startup EXIT

echo "==> startup page on :${PORT} (pid ${STARTUP_PID})"
echo "==> warming Rails on :${INTERNAL_PORT}"

bundle exec puma -C config/puma.rb -p "$INTERNAL_PORT" -b "tcp://127.0.0.1" &
WARM_PID=$!

ready=0
for _ in $(seq 1 120); do
  if bundle exec ruby -rnet/http -e "
    res = Net::HTTP.get_response(URI('http://127.0.0.1:${INTERNAL_PORT}/up'))
    exit(res.is_a?(Net::HTTPSuccess) ? 0 : 1)
  " 2>/dev/null; then
    ready=1
    break
  fi
  if ! kill -0 "$WARM_PID" 2>/dev/null; then
    echo "==> warm boot failed: puma exited early" >&2
    exit 1
  fi
  sleep 0.5
done

if [ "$ready" -ne 1 ]; then
  echo "==> warm boot timed out waiting for /up" >&2
  exit 1
fi

kill "$WARM_PID" 2>/dev/null || true
wait "$WARM_PID" 2>/dev/null || true
trap - EXIT
stop_startup

echo "==> Rails ready; starting Puma on :${PORT}"
exec bundle exec puma -C config/puma.rb
