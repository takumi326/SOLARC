#!/usr/bin/env bash
# Production Docker boot:
# 1. db:migrate（Render Free は Pre-Deploy 不可のため起動時に実行）
# 2. Puma を $PORT で起動
#
# Paid プランで Pre-Deploy に bin/render-release を設定している場合も、
# 未適用 migration があればここで当てる（二重実行は db:migrate が no-op）。
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> db:migrate"
bundle exec rails db:migrate

echo "==> starting Puma on :${PORT:-3000}"
exec bundle exec puma -C config/puma.rb
