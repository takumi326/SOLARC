<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">予測をまとめて編集（今年度12ヶ月）</h2>
    <p class="mt-1 text-xs text-slate-500">アンカー月: <%= format_month_label(@anchor_month) %></p>

    <%= form_with url: finance_bulk_forecasts_path, method: :post, class: "mt-4 space-y-3" do %>
      <input type="hidden" name="anchor_month" value="<%= month_input_value(@anchor_month) %>" />
      <div class="max-h-[60vh] overflow-y-auto rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs text-slate-500">
            <tr>
              <th class="px-3 py-2">月</th>
              <th class="px-3 py-2">収入</th>
              <th class="px-3 py-2">支出</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @fiscal_months.each_with_index do |month, idx| %>
              <% income = @forecasts[["income", month]]&.amount.to_i %>
              <% expense = @forecasts[["expense", month]]&.amount.to_i %>
              <tr>
                <td class="px-3 py-2"><%= format_month_label(month) %></td>
                <td class="px-3 py-2">
                  <input type="number" name="rows[<%= idx %>][income]" min="0" step="1" value="<%= income %>" class="w-full rounded border border-slate-300 px-2 py-1" />
                </td>
                <td class="px-3 py-2">
                  <input type="number" name="rows[<%= idx %>][expense]" min="0" step="1" value="<%= expense %>" class="w-full rounded border border-slate-300 px-2 py-1" />
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="flex gap-2">
        <%= link_to "キャンセル", finance_summary_path(month: format_month_input(@anchor_month)), class: btn_classes(:secondary) %>
        <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">保存</button>
      </div>
    <% end %>
  </section>
</div>
