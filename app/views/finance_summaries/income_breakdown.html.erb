<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-2">
      <h2 class="flex flex-wrap items-baseline gap-x-3 text-xl font-bold">
        <span>収入の内訳（<%= format_month_label(@month) %>）</span>
        <span class="text-lg font-semibold text-emerald-700"><%= format_yen(@dashboard[:income_line_items].sum { |row| row[:amount].to_d }) %></span>
      </h2>
      <%= link_to "戻る", finance_summary_path(month: @month_input), class: btn_classes(:secondary) %>
    </div>

    <div class="mb-3 inline-flex flex-wrap rounded-full bg-slate-100 p-0.5 text-xs">
      <%= link_to "カテゴリ別", finance_income_breakdown_path(month: @month_input, view: "category"), class: breakdown_tab_class(@view == "category") %>
      <%= link_to "一覧", finance_income_breakdown_path(month: @month_input, view: "lines"), class: breakdown_tab_class(@view == "lines") %>
    </div>

    <% if @view == "category" %>
      <%= render "finance_summaries/category_breakdown", groups: @dashboard[:income_by_category_groups], accent: "text-emerald-700" %>
    <% else %>
      <%= render "finance_summaries/income_line_items", items: @dashboard[:income_line_items] %>
    <% end %>

    <% if @dashboard[:income_by_category_groups].empty? && @dashboard[:income_line_items].empty? %>
      <p class="mt-2 text-xs text-slate-500">
        <% if @income_mode == "予" %>
          この月は実績ベースの収入内訳がまだありません。
        <% else %>
          実績取引はある設定ですが、内訳を表示できませんでした。
        <% end %>
      </p>
    <% end %>
  </section>
</div>
