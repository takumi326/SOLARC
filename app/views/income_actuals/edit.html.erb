<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">収入実績を編集</h2>
    <%= form_with url: finance_income_actual_path(@income, @transaction), method: :patch, class: "mt-4 space-y-3" do %>
      <p class="text-sm"><span class="text-slate-600">月</span> <span class="font-medium"><%= format_month_label(@transaction.month) %></span></p>
      <label class="block text-sm">金額 <input type="number" name="actual[amount]" min="0" value="<%= @transaction.amount.to_i %>" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" required autofocus /></label>
      <div class="flex gap-2">
        <%= link_to "キャンセル", finance_income_actuals_path(@income), class: btn_classes(:secondary) %>
        <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">保存</button>
      </div>
    <% end %>
  </section>
</div>
