<% methods = PaymentMethod.order(:name, :id) %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-3 flex items-center justify-between">
    <h3 class="text-lg font-semibold">支払方法</h3>
    <%= link_to "＋ 追加", new_finance_masters_payment_method_path, class: btn_classes(:primary) %>
  </div>

  <% if methods.empty? %>
    <p class="text-sm text-slate-500">支払方法が未登録</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-slate-200">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs text-slate-500">
          <tr><th class="px-3 py-2">名前</th><th class="px-3 py-2">種別</th><th class="px-3 py-2"></th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% methods.each do |method| %>
            <tr>
              <td class="px-3 py-2"><%= method.name %></td>
              <td class="px-3 py-2"><%= payment_method_type_label(method.method_type) %></td>
              <td class="px-3 py-2">
                <div class="flex flex-nowrap items-center gap-1">
                  <%= link_to "編集", edit_finance_masters_payment_method_path(method), class: btn_classes(:secondary, extra: "whitespace-nowrap px-2 py-1 text-xs") %>
                  <%= button_to "削除", finance_masters_payment_method_path(method), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger, extra: "whitespace-nowrap px-2 py-1 text-xs") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
