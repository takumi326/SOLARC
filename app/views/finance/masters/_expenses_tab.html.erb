<% filter = params[:filter].presence_in(%w[one_time recurring]) || "one_time" %>
<% group = params[:group].presence_in(%w[category month]) || "category" %>
<% group = "category" unless filter == "one_time" %>
<% expenses = Expense.joins(:minor_category).preload(:minor_category, :payment_method).order("minor_categories.name ASC, expenses.id ASC").select { |e| e.expense_type == filter } %>
<% minors = MinorCategory.joins(:major_category).includes(:major_category).index_by(&:id) %>
<% sections = if group == "month"
  expenses.group_by { |e| e.start_month.beginning_of_month }.sort_by { |month, _| month }.reverse
else
  expenses.group_by { |e| minors[e.minor_category_id]&.major_category&.name || "—" }.sort_by { |name, _| name }
end %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-3">
    <h3 class="text-lg font-semibold">支出</h3>
  </div>

  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex rounded-full bg-slate-100 p-0.5 text-xs">
        <%= link_to "単発", finance_masters_path(tab: "expenses", filter: "one_time", group: group), class: breakdown_tab_class(filter == "one_time") %>
        <%= link_to "定期", finance_masters_path(tab: "expenses", filter: "recurring"), class: breakdown_tab_class(filter == "recurring") %>
      </div>
      <% if filter == "one_time" %>
        <div class="inline-flex rounded-full bg-slate-100 p-0.5 text-xs">
          <%= link_to "カテゴリ", finance_masters_path(tab: "expenses", filter: "one_time", group: "category"), class: breakdown_tab_class(group == "category") %>
          <%= link_to "月", finance_masters_path(tab: "expenses", filter: "one_time", group: "month"), class: breakdown_tab_class(group == "month") %>
        </div>
      <% end %>
    </div>
    <div class="flex gap-2">
      <%= link_to "＋ 単発", new_finance_masters_expense_path(expense_type: "one_time"), class: btn_classes(filter == "one_time" ? :primary : :secondary) %>
      <%= link_to "＋ 定期", new_finance_masters_expense_path(expense_type: "recurring"), class: btn_classes(filter == "recurring" ? :primary : :secondary) %>
    </div>
  </div>

  <% if expenses.empty? %>
    <p class="text-sm text-slate-500">条件に一致する支出がありません</p>
  <% else %>
    <ul class="space-y-2">
      <% sections.each do |section_name, rows| %>
        <% section_label = group == "month" ? format_month_label(section_name) : section_name %>
        <% sorted_rows = group == "month" ? rows.sort_by { |row| [ minors[row.minor_category_id]&.major_category&.name || "", minors[row.minor_category_id]&.name || "", row.id ] } : rows %>
        <li class="rounded-lg border border-slate-200">
          <details open>
            <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2 text-sm">
              <span class="font-medium"><%= section_label %></span>
              <span class="text-xs text-slate-500"><%= rows.size %>件</span>
            </summary>
            <div class="overflow-x-auto border-t border-slate-100">
              <table class="min-w-[820px] divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-xs text-slate-500">
                  <tr>
                    <th class="px-3 py-2">小カテゴリ</th>
                    <th class="px-3 py-2">マスタのメモ</th>
                    <th class="px-3 py-2">金額</th>
                    <th class="px-3 py-2">支払方法</th>
                    <% if group == "category" %>
                      <th class="px-3 py-2">月</th>
                    <% end %>
                    <th class="px-3 py-2"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% sorted_rows.each do |row| %>
                    <tr>
                      <td class="px-3 py-2"><%= minors[row.minor_category_id]&.name %></td>
                      <td class="px-3 py-2"><%= master_memo_label(row.memo) %></td>
                      <td class="px-3 py-2"><%= format_yen(row.amount) %></td>
                      <td class="px-3 py-2"><%= row.payment_method.name %></td>
                      <% if group == "category" %>
                        <td class="px-3 py-2"><%= format_month_label(row.start_month) %></td>
                      <% end %>
                      <td class="px-3 py-2">
                        <div class="flex gap-1">
                          <%= link_to "詳細", finance_expense_actuals_path(row), class: btn_classes(:link, extra: "px-2 py-1 text-xs") %>
                          <%= link_to "編集", edit_finance_masters_expense_path(row), class: btn_classes(:secondary, extra: "px-2 py-1 text-xs") %>
                          <%= button_to "削除", finance_masters_expense_path(row), method: :delete, form: { data: { turbo_confirm: "マスタと紐づく実績も削除されます。よろしいですか？" } }, class: btn_classes(:danger, extra: "px-2 py-1 text-xs") %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
