<div class="mx-auto max-w-2xl space-y-4">
  <p class="text-sm text-slate-500">
    <%= link_to "株一覧", stocks_path, class: "text-indigo-600 hover:underline" %>
    <span> / 業種</span>
  </p>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">業種（カスタム追加）</h2>
    <p class="mt-1 text-sm text-slate-500">CSV 取込時にも自動作成されます。手動で追加する場合はここから登録してください。</p>

    <%= form_with model: @industry, url: industries_path, class: "mt-4 flex flex-wrap items-end gap-2" do |form| %>
      <label class="flex min-w-[12rem] flex-1 flex-col gap-1 text-sm">
        <span class="text-slate-600">業種名</span>
        <%= form.text_field :name, class: "rounded-lg border border-slate-300 px-3 py-2", placeholder: "例: 監視リスト" %>
      </label>
      <%= form.submit "追加", class: btn_primary_classes %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-lg font-semibold">登録済み業種</h3>
    <% if @industries.empty? %>
      <p class="mt-3 text-sm text-slate-500">まだありません。</p>
    <% else %>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        <% @industries.each do |industry| %>
          <li class="flex items-center justify-between gap-2 py-2">
            <span><%= industry.name %></span>
            <span class="text-xs text-slate-400"><%= industry.stocks.count %> 銘柄</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
