<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">ルーチンの項目を編集</h2>
        <p class="mt-1 text-xs text-slate-500">文言の追加・変更・並び替えができます。完了条件は変わりません。</p>
      </div>
      <%= link_to "ダッシュボードへ", daily_routine_path, class: btn_classes(:secondary) %>
    </div>

    <div class="space-y-6">
      <% DailyRoutineItem::SLOTS.each do |slot| %>
        <% items = @items_by_slot[slot] || [] %>
        <div class="rounded-xl border border-slate-200 p-4">
          <h3 class="mb-3 text-base font-semibold"><%= DailyRoutineItem::SLOT_LABELS[slot] %></h3>

          <ul class="space-y-2">
            <% items.each_with_index do |item, index| %>
              <li class="flex flex-col gap-2 rounded-lg border border-slate-100 bg-slate-50 p-3 sm:flex-row sm:items-center">
                <%= form_with model: item, url: daily_routine_item_path(item), method: :patch, class: "flex min-w-0 flex-1 flex-col gap-2 sm:flex-row sm:items-center" do |f| %>
                  <%= f.text_field :label, class: "w-full min-w-0 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
                  <%= f.submit "保存", class: btn_classes(:secondary) %>
                <% end %>
                <div class="flex flex-wrap gap-2">
                  <%= button_to "↑", move_up_daily_routine_item_path(item), method: :patch, class: btn_classes(:secondary), disabled: index.zero? %>
                  <%= button_to "↓", move_down_daily_routine_item_path(item), method: :patch, class: btn_classes(:secondary), disabled: index == items.size - 1 %>
                  <%= button_to "削除", daily_routine_item_path(item), method: :delete, class: btn_classes(:danger), form: { data: { turbo_confirm: "この項目を削除しますか？" } } %>
                </div>
              </li>
            <% end %>
          </ul>

          <%= form_with url: daily_routine_items_path, scope: :daily_routine_item, class: "mt-3 flex flex-col gap-2 sm:flex-row sm:items-center" do |f| %>
            <%= f.hidden_field :slot, value: slot %>
            <%= f.text_field :label, placeholder: "新しい項目", required: true, class: "w-full min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
            <%= f.submit "追加", class: btn_classes(:primary) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>
