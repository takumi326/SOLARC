<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">設定</h2>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-lg font-semibold">TradingView チャート</h3>
    <p class="mt-1 text-sm text-slate-600">
      銘柄一覧・詳細の「チャート」で開くレイアウトです。TradingView で開きたいチャートの URL にある ID を入れてください（例: <code class="rounded bg-slate-100 px-1">https://jp.tradingview.com/chart/8WvKf6oB/</code> なら <code class="rounded bg-slate-100 px-1">8WvKf6oB</code>）。
    </p>

    <%= form_with model: @setting, url: stock_setting_path, method: :patch, class: "mt-4 space-y-3 text-sm" do |form| %>
      <label class="block">
        <span class="text-slate-700">チャート ID</span>
        <%= form.text_field :tradingview_chart_id, required: true, maxlength: 40, class: "mt-1 w-full max-w-md rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
      </label>
      <div class="flex flex-wrap gap-2">
        <%= form.submit "保存", class: btn_primary_classes %>
      </div>
    <% end %>
  </section>
</div>
