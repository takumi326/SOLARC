<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">支出実績を編集</h2>
    <%= form_with url: finance_expense_actual_path(@expense, @transaction), method: :patch, class: "mt-4 space-y-3" do %>
      <label class="block text-sm">月 <input type="month" name="actual[month]" value="<%= format_month_input(@transaction.month) %>" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" required /></label>
      <label class="block text-sm">金額 <input type="number" name="actual[amount]" min="0" value="<%= @transaction.amount.abs.to_i %>" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" required /></label>
      <div class="flex gap-2">
        <%= link_to "キャンセル", finance_expense_actuals_path(@expense), class: btn_classes(:secondary) %>
        <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">保存</button>
      </div>
    <% end %>
  </section>
</div>
