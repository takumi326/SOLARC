<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-bold">支出実績: <%= @expense.minor_category.major_category.name %> / <%= @expense.minor_category.name %></h2>
      <%= link_to "戻る", finance_masters_path(tab: "expenses"), class: btn_classes(:secondary) %>
    </div>

    <% if @expense.memo.present? %>
      <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm">
        <p class="text-xs font-medium text-slate-500">マスタのメモ</p>
        <p class="mt-1 whitespace-pre-wrap"><%= @expense.memo %></p>
      </div>
    <% end %>

    <% if @expense.expense_type_recurring? %>
      <%= form_with url: bulk_from_month_finance_expense_actuals_path(@expense), method: :post, class: "mb-4 rounded-lg border border-indigo-200 bg-indigo-50/60 px-3 py-3 space-y-2" do %>
        <p class="text-sm font-medium">指定月以降を一括変更</p>
        <div class="flex flex-wrap items-end gap-3">
          <label class="text-xs">開始月 <input type="month" name="from_month" class="rounded-md border border-slate-300 px-2 py-1 text-sm" required /></label>
          <label class="text-xs">金額 <input type="number" name="amount" min="0" value="<%= @expense.amount.to_i %>" class="rounded-md border border-slate-300 px-2 py-1 text-sm" required /></label>
          <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">一括で反映</button>
        </div>
      <% end %>
    <% end %>

    <% if @actuals.empty? %>
      <p class="text-sm text-slate-500">実績データがありません</p>
    <% else %>
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs text-slate-500"><tr><th class="px-3 py-2">月</th><th class="px-3 py-2">金額</th><th class="px-3 py-2"></th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% @actuals.each do |tx| %>
            <tr>
              <td class="px-3 py-2"><%= format_month_label(tx.month) %></td>
              <td class="px-3 py-2"><%= format_yen(tx.amount.abs) %></td>
              <td class="px-3 py-2">
                <div class="flex items-center gap-2">
                  <%= link_to "編集", edit_finance_expense_actual_path(@expense, tx), class: btn_classes(:secondary, extra: "px-2 py-1 text-xs") %>
                  <%= button_to "削除", finance_expense_actual_path(@expense, tx), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger, extra: "px-2 py-1 text-xs") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
</div>
