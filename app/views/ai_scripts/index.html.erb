<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">AI スクリプト一覧</h2>
      <%= link_to "新規登録", new_ai_script_path, class: btn_primary_classes %>
    </div>

    <% if @scripts.empty? %>
      <p class="text-sm text-slate-500">まだ登録がありません。</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500">
              <th class="py-2 pr-3">バージョン名</th>
              <th class="py-2 pr-3">プロンプト（先頭）</th>
              <th class="py-2 pr-3"></th>
            </tr>
          </thead>
          <tbody>
            <% @scripts.each do |script| %>
              <tr class="border-b border-slate-100">
                <td class="py-2 pr-3 font-medium"><%= script.version_name %></td>
                <td class="max-w-md truncate py-2 pr-3 text-slate-600"><%= script.prompt.to_s.truncate(120) %></td>
                <td class="py-2 pr-3 whitespace-nowrap">
                  <%= link_to "編集", edit_ai_script_path(script), class: btn_classes(:secondary, extra: "px-2.5 py-1 text-xs") %>
                  <%= button_to "削除", ai_script_path(script), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger, extra: "px-2.5 py-1 text-xs") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
