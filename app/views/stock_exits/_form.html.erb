<% record = local_assigns.fetch(:record) %>
<% stock = local_assigns.fetch(:stock) %>
<% trade_type = local_assigns.fetch(:trade_type) %>
<% judgment_type = local_assigns.fetch(:judgment_type) %>
<% ai_script_id = local_assigns.fetch(:ai_script_id) %>
<% ai_scripts = local_assigns[:ai_scripts] %>
<% submit_label = local_assigns.fetch(:submit_label, "保存") %>
<% form_url = local_assigns.fetch(:form_url) %>
<% form_method = local_assigns.fetch(:form_method, :post) %>

<%= form_with model: record, url: form_url, scope: :exit, method: form_method, class: "space-y-3 text-sm" do |form| %>
  <%= form.hidden_field :stock_id, value: stock.id %>
  <%= form.hidden_field :trade_type, value: trade_type %>
  <%= form.hidden_field :judgment_type, value: judgment_type %>
  <% if judgment_type == "ai" %>
    <% if ai_scripts.blank? %>
      <p class="text-rose-600">AI スクリプトを先に登録してください。</p>
    <% else %>
      <label class="block">
        <span class="text-slate-700">AI スクリプト</span>
        <%= form.collection_select :ai_script_id, ai_scripts, :id, :version_name, { selected: ai_script_id, include_blank: "選択してください" }, class: "mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5", required: true %>
      </label>
    <% end %>
  <% end %>

  <label class="block">
    <span class="text-slate-700">イグジット理由</span>
    <%= form.text_area :exit_reason, rows: 4, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">株数</span>
    <%= form.number_field :shares, min: 1, step: 1, inputmode: "numeric", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">予定価格</span>
    <%= form.number_field :expected_price, min: 0, step: :any, inputmode: "decimal", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">約定価格</span>
    <%= form.number_field :actual_price, min: 0, step: :any, inputmode: "decimal", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">約定日</span>
    <%= form.date_field :traded_at, max: Date.current.iso8601, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    <p class="mt-1 text-xs text-slate-500">予定価格か約定価格のどちらかは必須。約定するときは株数・約定価格・約定日をセット。約定日は今日以前のみ</p>
  </label>
  <label class="block">
    <span class="text-slate-700">レビュー</span>
    <%= form.select :review_result, options_for_select([["", ""], ["計画どおり", "as_planned"], ["見逃し", "missed"], ["一部", "partial"]], record.review_result), {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5" %>
  </label>
  <label class="block">
    <span class="text-slate-700">外れた点</span>
    <%= form.text_area :review_missed, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">学び</span>
    <%= form.text_area :review_learning, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>
  <label class="block">
    <span class="text-slate-700">メモ</span>
    <%= form.text_area :memo, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </label>

  <div class="flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-3">
    <%= link_to "キャンセル", stock_timeline_path_for(stock, trade_type: trade_type, judgment_type: judgment_type, ai_script_id: ai_script_id), class: btn_secondary_classes %>
    <%= form.submit submit_label, class: btn_primary_classes %>
  </div>
<% end %>
