<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">取引ルール</h2>
      <%= link_to "新規作成", new_stock_trade_rule_path, class: btn_classes(:primary) %>
    </div>

    <% if @rules.empty? %>
      <p class="text-sm text-slate-500">まだ取引ルールがありません。</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs text-slate-500">
            <tr>
              <th class="px-3 py-2">タイトル</th>
              <th class="px-3 py-2">本文（先頭）</th>
              <th class="px-3 py-2">更新</th>
              <th class="px-3 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @rules.each do |rule| %>
              <tr>
                <td class="px-3 py-2 font-medium"><%= rule.title %></td>
                <td class="max-w-md truncate px-3 py-2 text-slate-600"><%= rule.body.to_s.truncate(120) %></td>
                <td class="whitespace-nowrap px-3 py-2 text-slate-500"><%= l(rule.updated_at, format: :short) %></td>
                <td class="px-3 py-2">
                  <div class="flex flex-nowrap items-center gap-1">
                    <%= link_to "詳細", stock_trade_rule_path(rule), class: btn_classes(:link, extra: "whitespace-nowrap px-2 py-1 text-xs") %>
                    <%= link_to "編集", edit_stock_trade_rule_path(rule), class: btn_classes(:secondary, extra: "whitespace-nowrap px-2 py-1 text-xs") %>
                    <%= button_to "削除", stock_trade_rule_path(rule), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger, extra: "whitespace-nowrap px-2 py-1 text-xs") %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
