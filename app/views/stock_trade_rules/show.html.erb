<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">取引ルール</h2>
        <p class="mt-1 text-xs text-slate-500">更新日 <%= @rule.updated_on_label %></p>
      </div>
      <%= link_to "編集", edit_stock_trade_rule_path, class: btn_classes(:primary) %>
    </div>
    <% if @rule.body.present? %>
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap"><%= @rule.body %></div>
    <% else %>
      <p class="text-sm text-slate-500">まだルールが未記入です。編集から入力してください。</p>
    <% end %>
  </section>
</div>
