<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="text-xs text-slate-500">取引ルール</p>
        <h2 class="text-xl font-bold"><%= @rule.title %></h2>
      </div>
      <div class="flex flex-nowrap items-center gap-2">
        <%= link_to "一覧", stock_trade_rules_path, class: btn_classes(:secondary) %>
        <%= link_to "編集", edit_stock_trade_rule_path(@rule), class: btn_classes(:primary) %>
      </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap"><%= @rule.body %></div>
  </section>
</div>
