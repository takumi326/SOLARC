<div class="space-y-3">
  <section class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">実績を取込</h2>
      <%= link_to "プロンプト編集", finance_settings_path(anchor: "import-prompt"), class: btn_classes(:link) %>
    </div>

    <% if @phase == "preview" && @pending_rows.present? %>
      <%= form_with url: finance_import_path, method: :get, class: "mb-2 flex flex-wrap items-center gap-2 text-sm" do %>
        <label class="flex flex-wrap items-center gap-2">
          <span class="text-slate-600">比較する月</span>
          <input type="month" name="compare_month" value="<%= @compare_month_input %>" class="rounded-lg border border-slate-300 px-2 py-1 text-sm" onchange="this.form.requestSubmit()" />
        </label>
      <% end %>

      <% if @import_summary.present? %>
        <div class="mb-3 rounded-lg border border-indigo-200 bg-indigo-50/50 px-3 py-2 text-sm text-indigo-950">
          <p class="font-medium">取り込み前チェック</p>
          <ol class="mt-1 list-decimal space-y-0.5 pl-5 text-xs text-indigo-900">
            <li>下の台帳を確認する</li>
            <li>「過不足チェック用プロンプト」をコピーし、Claude に貼る</li>
            <li>スマホの明細・請求スクショを添付して過不足を聞く</li>
            <li>不足 JSON があれば下の欄に貼って追加し、最後に取り込む</li>
          </ol>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button type="button" class="<%= btn_classes(:secondary) %>" data-copy-text="<%= h(@gap_check_prompt) %>" data-copy-label="過不足チェック用プロンプト" data-copy-flash="過不足チェック用プロンプトをコピーしました">過不足チェック用プロンプトをコピー</button>
            <a href="https://claude.ai/new" target="_blank" rel="noopener noreferrer" class="<%= btn_classes(:link) %>">Claude</a>
          </div>
          <div class="mt-2"><%= render "statement_links" %></div>
        </div>
      <% end %>

      <% if @import_summary.present? %>
        <% if @import_summary.by_month.size > 1 %>
          <div class="mb-3 overflow-x-auto">
            <table class="min-w-full text-left text-xs text-slate-600">
              <thead><tr><th class="pr-3 pb-1">利用月</th><th class="pr-3 pb-1 text-right">件数</th><th class="pb-1 text-right">合計</th></tr></thead>
              <tbody>
                <% @import_summary.by_month.each do |month, stats| %>
                  <tr><td class="pr-3 py-0.5"><%= month %></td><td class="pr-3 py-0.5 text-right"><%= stats[:count] %></td><td class="py-0.5 text-right tabular-nums"><%= format_yen(stats[:amount]) %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>

<%# 「候補に追加」は formaction で別パスへ送るため、送信先を限定しないトークンを埋める %>
      <%= form_with url: commit_finance_import_path, method: :post, authenticity_token: form_authenticity_token,
                    class: "space-y-3", data: { import_preview_form: true, draft_url: update_draft_finance_import_path } do %>
      <div class="mb-3 space-y-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
        <label class="block text-sm">
          <span class="font-medium text-slate-800">不足分 JSON を追加</span>
          <span class="ml-1 text-xs text-slate-500">過不足チェックで返ってきた JSON（--- 以降はそのままで OK）</span>
          <textarea name="raw_json" rows="4" placeholder='[{"date":"<%= @compare_month_input %>-15","month":"<%= @compare_month_input %>","card_id":"paypay_jcb","minor_category_id":<%= @expense_minors.first&.id || 1 %>,"amount":3300,"memo":"[不足追加] ...","source_id":"gap-1"}]' class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 font-mono text-xs"></textarea>
        </label>
        <div class="flex justify-end">
          <button type="submit" formaction="<%= append_finance_import_path %>" class="<%= btn_classes(:secondary) %> cursor-pointer">候補に追加</button>
        </div>
      </div>

      <% if @card_id_mappings.present? %>
        <div class="overflow-x-auto rounded-lg border border-slate-200">
          <table id="import-card-summary" class="w-full min-w-[40rem] text-left text-sm">
            <thead class="bg-slate-50 text-xs text-slate-500">
              <tr>
                <th class="px-2 py-1.5">支払方法</th>
                <th class="px-2 py-1.5">card_id</th>
                <th class="whitespace-nowrap px-2 py-1.5 text-right">件数</th>
                <th class="whitespace-nowrap px-2 py-1.5 text-right">合計</th>
                <th class="whitespace-nowrap px-2 py-1.5 text-right">VPass</th>
                <th class="whitespace-nowrap px-2 py-1.5 text-right">PayPal</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @card_id_mappings.each do |mapping| %>
                <tr data-import-card-summary-row data-card-id="<%= mapping[:card_id] %>">
                  <td class="px-2 py-1.5">
                    <select
                      name="card_payment_methods[<%= mapping[:card_id] %>]"
                      data-import-card-payment-method
                      data-card-id="<%= mapping[:card_id] %>"
                      class="w-full min-w-[9rem] rounded border border-slate-300 px-1.5 py-1 text-xs"
                    >
                      <option value="">選択してください</option>
                      <% @card_payment_methods.each do |pm| %>
                        <option value="<%= pm.id %>" <%= mapping[:payment_method_id] == pm.id ? "selected" : "" %>><%= pm.name %></option>
                      <% end %>
                    </select>
                  </td>
                  <td class="px-2 py-1.5 font-mono text-xs text-slate-600"><%= mapping[:card_id] %></td>
                  <td class="px-2 py-1.5 text-right tabular-nums" data-import-card-summary-count><%= mapping[:count] %></td>
                  <td class="px-2 py-1.5 text-right tabular-nums" data-import-card-summary-amount><%= format_yen(mapping[:amount]) %></td>
                  <td class="px-2 py-1.5 text-right text-xs tabular-nums text-slate-600">
                    <% if mapping[:vpass][:count].positive? %>
                      <%= mapping[:vpass][:count] %> 件 / <%= format_yen(mapping[:vpass][:amount]) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td class="px-2 py-1.5 text-right text-xs tabular-nums text-slate-600">
                    <% if mapping[:paypal][:count].positive? %>
                      <%= mapping[:paypal][:count] %> 件 / <%= format_yen(mapping[:paypal][:amount]) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <div class="space-y-3">
        <div class="flex min-h-0 flex-col rounded-lg border border-slate-200">
          <div class="flex shrink-0 items-center justify-between border-b border-slate-100 bg-slate-50 px-2 py-1.5">
            <h4 class="text-sm font-medium text-slate-800">台帳（<%= @compare_month_input %>）</h4>
            <span class="text-xs text-slate-500">保存済み＋この月の定期 / <%= @existing_rows.size %> 件</span>
          </div>
          <div class="max-h-72 overflow-x-auto">
            <table class="w-full min-w-[56rem] divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr>
                  <th class="whitespace-nowrap px-2 py-1.5">No.</th>
                  <th class="min-w-[9rem] px-2 py-1.5">支払方法</th>
                  <th class="whitespace-nowrap px-2 py-1.5">月</th>
                  <th class="min-w-[12rem] px-2 py-1.5">カテゴリ</th>
                  <th class="whitespace-nowrap px-2 py-1.5 text-right">金額</th>
                  <th class="min-w-[10rem] px-2 py-1.5">メモ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @existing_rows.each_with_index do |row, index| %>
                  <tr class="<%= row[:duplicate_with_pending] ? "bg-amber-50" : "" %>">
                    <td class="px-2 py-1.5 tabular-nums text-slate-500"><%= index + 1 %></td>
                    <td class="max-w-[10rem] px-2 py-1.5 text-xs text-slate-600">
                      <span class="block truncate" title="<%= row[:card_name] %>"><%= row[:card_name] %></span>
                    </td>
                    <td class="px-2 py-1.5 whitespace-nowrap"><%= row[:month_label] %></td>
                    <td class="px-2 py-1.5">
                      <%= row[:category_path] %>
                      <% if row[:recurring] %>
                        <span class="ml-1 rounded bg-indigo-100 px-1 py-0.5 text-[10px] font-medium text-indigo-800">定期</span>
                      <% end %>
                      <% if row[:duplicate_with_pending] %>
                        <span class="ml-1 rounded bg-amber-200 px-1 py-0.5 text-[10px] font-medium text-amber-900">No.<%= row[:pending_line_number] %> と重複</span>
                      <% end %>
                    </td>
                    <td class="px-2 py-1.5 text-right whitespace-nowrap tabular-nums"><%= format_yen(row[:amount]) %></td>
                    <td class="max-w-[14rem] px-2 py-1.5">
                      <span class="block truncate" title="<%= row[:memo] %>"><%= row[:memo].presence || "—" %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex min-h-0 flex-col rounded-lg border border-slate-200">
          <div class="flex shrink-0 items-center justify-between border-b border-slate-100 bg-slate-50 px-2 py-1.5">
            <h4 class="text-sm font-medium text-slate-800">これから保存する候補</h4>
            <span class="text-xs text-slate-500"><%= @right_table_rows.size %> 件</span>
          </div>
          <div class="max-h-72 overflow-x-auto">
            <table class="w-full min-w-[64rem] divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr>
                  <th class="whitespace-nowrap px-1.5 py-1.5"></th>
                  <th class="whitespace-nowrap px-1.5 py-1.5">No.</th>
                  <th class="min-w-[9rem] px-2 py-1.5">支払方法</th>
                  <th class="whitespace-nowrap px-2 py-1.5">月</th>
                  <th class="min-w-[14rem] px-2 py-1.5">カテゴリ</th>
                  <th class="whitespace-nowrap px-2 py-1.5 text-right">金額</th>
                  <th class="min-w-[12rem] px-2 py-1.5">メモ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @right_table_rows.each do |row| %>
                  <% duplicate = @duplicate_line_numbers.include?(row.line_number) %>
                  <%
                    mapped_pm = @card_payment_methods.find { |pm| pm.id == row.payment_method_id }
                    payment_label = mapped_pm&.name.presence || "未選択"
                  %>
                  <tr
                    class="<%= duplicate ? "bg-amber-50" : "" %>"
                    data-card-id="<%= row.card_id %>"
                    <% unless duplicate %>
                      data-import-candidate
                      data-line-number="<%= row.line_number %>"
                      data-amount="<%= row.amount %>"
                    <% end %>
                  >
                    <td class="px-1.5 py-1.5">
                      <% if duplicate %>
                        <span class="rounded bg-amber-200 px-1 py-0.5 text-[10px] font-medium text-amber-900">重複</span>
                      <% else %>
                        <input type="checkbox" name="line_numbers[]" value="<%= row.line_number %>" <%= @selected_line_numbers.include?(row.line_number) ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300" />
                      <% end %>
                    </td>
                    <td class="px-1.5 py-1.5 font-semibold tabular-nums text-slate-700"><%= row.line_number %></td>
                    <td class="max-w-[10rem] px-2 py-1.5 text-xs text-slate-600">
                      <span class="block truncate" data-import-payment-label title="<%= payment_label %>"><%= payment_label %></span>
                      <span class="mt-0.5 block truncate font-mono text-[10px] text-slate-400" title="<%= row.card_id %>"><%= row.card_id %></span>
                    </td>
                    <td class="px-2 py-1.5 whitespace-nowrap"><%= row.month_label %></td>
                    <td class="px-2 py-1.5">
                      <select name="rows[<%= row.line_number %>][minor_category_id]" data-import-category class="w-full min-w-[12rem] rounded border border-slate-300 px-1.5 py-1 text-xs">
                        <% @expense_minors.each do |minor| %>
                          <option value="<%= minor.id %>" <%= row.minor_category_id == minor.id ? "selected" : "" %>><%= minor.major_category.name %> / <%= minor.name %></option>
                        <% end %>
                      </select>
                    </td>
                    <td class="px-2 py-1.5 text-right whitespace-nowrap tabular-nums"><%= format_yen(row.amount) %></td>
                    <td class="px-2 py-1.5">
                      <input type="text" name="rows[<%= row.line_number %>][memo]" value="<%= row.memo %>" maxlength="2000" class="w-full min-w-[10rem] rounded border border-slate-300 px-1.5 py-1 text-xs" />
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <% if @final_preview_rows.present? %>
          <%
            existing_final_rows = @final_preview_rows.select { |row| row.kind == :existing }
            existing_payload = existing_final_rows.map { |row|
              {
                label: row.label,
                cardName: row.card_name.to_s,
                categoryPath: row.category_path,
                amount: row.amount,
                memo: row.memo.to_s
              }
            }
            grouped_final = @final_preview_rows.group_by { |row| row.card_name.presence || "未設定" }.sort_by(&:first)
          %>
          <div
            id="import-final-preview"
            class="rounded-lg border border-emerald-200 bg-emerald-50/40"
            data-existing-rows="<%= ERB::Util.html_escape(existing_payload.to_json) %>"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-emerald-100 px-2 py-1.5">
              <h4 class="text-sm font-medium text-emerald-900">この月の最終イメージ（<%= @compare_month_input %>）</h4>
              <span id="import-final-preview-summary" class="text-sm font-semibold tabular-nums text-emerald-900">
                <%= @final_preview_rows.size %> 件 / <%= format_yen(@final_preview_rows.sum(&:amount)) %>
              </span>
            </div>
            <div id="import-final-preview-by-card" class="max-h-96 space-y-3 overflow-y-auto p-2">
              <% grouped_final.each do |card_name, rows| %>
                <div class="overflow-x-auto rounded border border-emerald-100 bg-white/70">
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-emerald-100 bg-emerald-50/80 px-2 py-1.5">
                    <span class="text-xs font-medium text-emerald-900"><%= card_name %></span>
                    <span class="text-xs tabular-nums text-emerald-800"><%= rows.size %> 件 / <%= format_yen(rows.sum(&:amount)) %></span>
                  </div>
                  <table class="w-full min-w-[48rem] divide-y divide-emerald-100 text-sm">
                    <thead class="text-left text-xs text-emerald-800">
                      <tr>
                        <th class="whitespace-nowrap px-2 py-1.5">区分</th>
                        <th class="min-w-[12rem] px-2 py-1.5">カテゴリ</th>
                        <th class="whitespace-nowrap px-2 py-1.5 text-right">金額</th>
                        <th class="min-w-[10rem] px-2 py-1.5">メモ</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-emerald-100/80">
                      <% rows.each do |row| %>
                        <tr class="<%= row.kind == :new ? "bg-white/60" : "" %>">
                          <td class="whitespace-nowrap px-2 py-1.5 text-xs text-emerald-800"><%= row.label %></td>
                          <td class="px-2 py-1.5"><%= row.category_path %></td>
                          <td class="px-2 py-1.5 text-right whitespace-nowrap tabular-nums"><%= format_yen(row.amount) %></td>
                          <td class="max-w-[14rem] px-2 py-1.5">
                            <span class="block truncate" title="<%= row.memo %>"><%= row.memo.presence || "—" %></span>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <input type="hidden" name="compare_month" value="<%= @compare_month_input %>" />
      <div class="flex justify-end gap-2">
        <%= link_to "戻って修正", finance_import_path(reset: 1), class: btn_classes(:secondary) %>
        <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">選択した行を取り込む</button>
      </div>
      <% end %>
      <%= javascript_include_tag "finance_import_preview", defer: true %>
    <% else %>
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <%= form_with url: finance_import_path, method: :get, class: "flex flex-wrap items-center gap-2 text-sm" do %>
            <span class="text-slate-600">対象月</span>
            <input type="month" name="prompt_month" value="<%= @import_prompt_month %>" class="rounded-lg border border-slate-300 px-2 py-1 text-sm" onchange="this.form.requestSubmit()" />
          <% end %>
          <button type="button" class="<%= btn_classes(:secondary) %>" data-copy-text="<%= h(@claude_prompt) %>" data-copy-label="プロンプト" data-copy-flash="プロンプトをコピーしました">プロンプトコピー</button>
          <a href="https://claude.ai/new" target="_blank" rel="noopener noreferrer" class="<%= btn_classes(:link) %>">Claude</a>
        </div>

        <%= render "statement_links" %>
      </div>

      <%= form_with url: finance_import_path, method: :post, class: "mt-3 space-y-3" do %>
        <label class="block text-sm">
          <span class="text-slate-600">JSON</span>
          <textarea name="raw_json" rows="10" placeholder='[{"date":"<%= @import_prompt_month %>-20","month":"<%= @import_prompt_month %>","card_id":"smcc_amazon","minor_category_id":<%= @expense_minors.first&.id || 1 %>,"amount":1200,"memo":"","source_id":"..."}]' class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 font-mono text-xs"><%= @raw_json %></textarea>
          <p class="mt-1 text-xs text-slate-500">1つの JSON に複数の card_id（例: smcc_amazon, paypay_jcb）を混在させて OK。検算ブロック（--- 以降）もそのまま貼り付けてください。</p>
        </label>
        <div class="flex justify-end gap-2">
          <%= link_to "キャンセル", finance_summary_path, class: btn_classes(:secondary) %>
          <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">内容を確認</button>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
