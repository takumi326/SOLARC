<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">実績を取込</h2>
      <%= link_to "プロンプト編集", finance_settings_path(anchor: "import-prompt"), class: btn_classes(:link) %>
    </div>

    <% if @phase == "preview" && @pending_rows.present? %>
      <p class="mb-3 text-sm text-slate-700">
        左で比較する月を選び、保存済みの<strong>単発</strong>支出と今回取り込む内容を並べて確認してください。右側で<strong>カテゴリ・メモ</strong>を直せます。チェックを付けた行だけが取り込まれます。
      </p>

      <%= form_with url: finance_import_path, method: :get, class: "mb-3 flex flex-wrap items-center gap-2 text-sm" do %>
        <span class="text-slate-600">比較する月</span>
        <input type="month" name="compare_month" value="<%= @compare_month_input %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm" onchange="this.form.requestSubmit()" />
      <% end %>

      <% if @hidden_duplicate_count.to_i.positive? %>
        <p class="mb-3 text-xs text-amber-800">保存済みと重複する <%= @hidden_duplicate_count %> 件は表示・取り込み対象から除いています。</p>
      <% end %>

      <div class="flex flex-col gap-4 lg:flex-row lg:items-stretch">
        <div class="flex min-h-0 flex-1 flex-col rounded-lg border border-slate-200">
          <h4 class="border-b border-slate-100 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-800">保存済みの単発支出</h4>
          <div class="min-h-0 max-h-72 flex-1 overflow-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr><th class="px-3 py-2">月</th><th class="px-3 py-2">カテゴリ</th><th class="px-3 py-2 text-right">金額</th><th class="px-3 py-2">メモ</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @existing_rows.reject { |r| r[:duplicate_with_pending] }.each do |row| %>
                  <tr>
                    <td class="px-3 py-2"><%= row[:month_label] %></td>
                    <td class="px-3 py-2"><%= row[:category_path] %></td>
                    <td class="px-3 py-2 text-right"><%= format_yen(row[:amount]) %></td>
                    <td class="px-3 py-2"><%= row[:memo].presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%= form_with url: commit_finance_import_path, method: :post, class: "flex min-h-0 flex-1 flex-col rounded-lg border border-slate-200" do %>
          <div class="flex shrink-0 items-center justify-between border-b border-slate-100 bg-slate-50 px-3 py-2">
            <h4 class="text-sm font-medium text-slate-800">今回取り込む（単発）</h4>
          </div>
          <div class="min-h-0 max-h-72 flex-1 overflow-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr><th class="w-10 px-2 py-2"></th><th class="px-3 py-2">月</th><th class="px-3 py-2">カテゴリ</th><th class="px-3 py-2 text-right">金額</th><th class="px-3 py-2">メモ</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @right_table_rows.each do |row| %>
                  <tr>
                    <td class="px-2 py-2">
                      <input type="checkbox" name="line_numbers[]" value="<%= row.line_number %>" <%= @selected_line_numbers.include?(row.line_number) ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300" />
                    </td>
                    <td class="px-3 py-2"><%= row.month_label %></td>
                    <td class="px-3 py-2">
                      <select name="rows[<%= row.line_number %>][minor_category_id]" class="w-full min-w-[10rem] rounded border border-slate-300 px-2 py-1 text-xs">
                        <% @expense_minors.each do |minor| %>
                          <option value="<%= minor.id %>" <%= row.minor_category_id == minor.id ? "selected" : "" %>><%= minor.major_category.name %> / <%= minor.name %></option>
                        <% end %>
                      </select>
                    </td>
                    <td class="px-3 py-2 text-right"><%= format_yen(row.amount) %></td>
                    <td class="px-3 py-2">
                      <input type="text" name="rows[<%= row.line_number %>][memo]" value="<%= row.memo %>" maxlength="2000" class="w-full min-w-[8rem] rounded border border-slate-300 px-2 py-1 text-xs" />
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <input type="hidden" name="compare_month" value="<%= @compare_month_input %>" />
          <div class="border-t border-slate-100 p-3 text-right">
            <%= link_to "戻って修正", finance_import_path(reset: 1), class: btn_classes(:secondary) %>
            <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">選択した行を取り込む</button>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <%= form_with url: finance_import_path, method: :get, class: "flex flex-wrap items-center gap-2 text-sm" do %>
            <span class="text-slate-600">対象月</span>
            <input type="month" name="prompt_month" value="<%= @import_prompt_month %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm" onchange="this.form.requestSubmit()" />
          <% end %>
          <button type="button" class="<%= btn_classes(:secondary) %>" data-copy-text="<%= h(@claude_prompt) %>" data-copy-label="プロンプト" data-copy-flash="プロンプトをコピーしました">プロンプトコピー</button>
          <a href="https://claude.ai/new" target="_blank" rel="noopener noreferrer" class="<%= btn_classes(:link) %>">Claude</a>
        </div>
        <% unless @fixed_payment_method&.method_type == "card" %>
          <p class="text-xs text-amber-800">支払方法「<%= FinanceImportClaudePromptBuilder::FIXED_PAYMENT_METHOD_NAME %>」（クレジットカード）をマスタに追加してください。</p>
        <% end %>
      </div>

      <%= form_with url: finance_import_path, method: :post, class: "mt-4 space-y-3" do %>
        <label class="block text-sm">
          <span class="text-slate-600">JSON</span>
          <textarea name="raw_json" rows="10" placeholder='[{"date":"<%= @import_prompt_month %>-20","month":"<%= @import_prompt_month %>","minor_category_id":<%= @expense_minors.first&.id || 1 %>,"amount":1200,"memo":"","source_id":"..."}]' class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs"><%= @raw_json %></textarea>
          <p class="mt-1 text-xs text-slate-500">検算ブロック（--- 以降）はそのまま貼り付けて OK です。</p>
        </label>
        <div class="flex justify-end gap-2">
          <%= link_to "キャンセル", finance_summary_path, class: btn_classes(:secondary) %>
          <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">内容を確認</button>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
