<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">実績を取込</h2>
      <%= link_to "プロンプト編集", finance_settings_path(anchor: "import-prompt"), class: btn_classes(:link) %>
    </div>

    <% if @phase == "preview" && @pending_rows.present? %>
      <p class="mb-3 text-sm text-slate-700">
        左で比較する月を選び、保存済みの<strong>単発</strong>支出と今回取り込む内容を並べて確認してください。右側で<strong>カテゴリ・メモ</strong>を直せます。チェックを付けた行だけが取り込まれます。
      </p>

      <%= form_with url: finance_import_path, method: :get, class: "mb-3 flex flex-wrap items-center gap-2 text-sm" do %>
        <span class="text-slate-600">比較する月</span>
        <input type="month" name="compare_month" value="<%= @compare_month_input %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm" onchange="this.form.requestSubmit()" />
      <% end %>

      <% if @import_summary.present? %>
        <div class="mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
            <p class="text-xs text-slate-500">JSON 全件</p>
            <p class="text-lg font-semibold tabular-nums"><%= @import_summary.total_count %> 件 / <%= format_yen(@import_summary.total_amount) %></p>
          </div>
          <div class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2">
            <p class="text-xs text-indigo-700">取り込み候補（重複除く）</p>
            <p class="text-lg font-semibold tabular-nums text-indigo-900"><%= @import_summary.importable_count %> 件 / <%= format_yen(@import_summary.importable_amount) %></p>
          </div>
          <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2">
            <p class="text-xs text-amber-800">重複除外（<%= @compare_month_input %>）</p>
            <p class="text-lg font-semibold tabular-nums text-amber-900"><%= @import_summary.duplicate_count %> 件 / <%= format_yen(@import_summary.duplicate_amount) %></p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
            <p class="text-xs text-slate-500">要確認メモ</p>
            <p class="text-lg font-semibold tabular-nums"><%= @import_summary.needs_review_count %> 件</p>
          </div>
        </div>

        <% if @import_summary.by_source[:vpass][:count].positive? || @import_summary.by_source[:paypal][:count].positive? %>
          <div class="mb-4 flex flex-wrap gap-2 text-xs">
            <% if @import_summary.by_source[:vpass][:count].positive? %>
              <span class="rounded-full bg-slate-200 px-2.5 py-1 text-slate-700">VPass <%= @import_summary.by_source[:vpass][:count] %> 件 / <%= format_yen(@import_summary.by_source[:vpass][:amount]) %></span>
            <% end %>
            <% if @import_summary.by_source[:paypal][:count].positive? %>
              <span class="rounded-full bg-slate-200 px-2.5 py-1 text-slate-700">PayPal <%= @import_summary.by_source[:paypal][:count] %> 件 / <%= format_yen(@import_summary.by_source[:paypal][:amount]) %></span>
            <% end %>
            <% if @import_summary.by_source[:unknown][:count].positive? %>
              <span class="rounded-full bg-slate-200 px-2.5 py-1 text-slate-500">経路不明 <%= @import_summary.by_source[:unknown][:count] %> 件</span>
            <% end %>
          </div>
        <% end %>

        <% if @import_summary.by_month.size > 1 %>
          <div class="mb-4 overflow-x-auto">
            <table class="min-w-full text-left text-xs text-slate-600">
              <thead><tr><th class="pr-4 pb-1">利用月</th><th class="pr-4 pb-1 text-right">件数</th><th class="pb-1 text-right">合計</th></tr></thead>
              <tbody>
                <% @import_summary.by_month.each do |month, stats| %>
                  <tr><td class="pr-4 py-0.5"><%= month %></td><td class="pr-4 py-0.5 text-right"><%= stats[:count] %></td><td class="py-0.5 text-right tabular-nums"><%= format_yen(stats[:amount]) %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <% if @verification_text.present? %>
          <details class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
            <summary class="cursor-pointer font-medium text-slate-700">Claude 検算（--- 以降）</summary>
            <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap font-mono text-slate-600"><%= @verification_text %></pre>
          </details>
        <% end %>
      <% end %>

      <% if @duplicate_pairs.present? %>
        <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50/60 p-3">
          <p class="mb-2 text-sm font-medium text-amber-900">重複（<%= @compare_month_input %> — カテゴリ・金額が保存済みと一致）</p>
          <p class="mb-2 text-xs text-amber-800">以下は右の取り込みリストから除外しています。既に登録済みならそのままで問題ありません。</p>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-xs">
              <thead class="text-amber-900/70">
                <tr>
                  <th class="px-2 py-1">保存済みメモ</th>
                  <th class="px-2 py-1">カテゴリ</th>
                  <th class="px-2 py-1 text-right">金額</th>
                  <th class="px-2 py-1 text-slate-400">↔</th>
                  <th class="px-2 py-1">今回メモ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-amber-100">
                <% @duplicate_pairs.each do |pair| %>
                  <tr>
                    <td class="px-2 py-1.5"><%= pair.existing[:memo].presence || "—" %></td>
                    <td class="px-2 py-1.5"><%= pair.existing[:category_path] %></td>
                    <td class="px-2 py-1.5 text-right tabular-nums"><%= format_yen(pair.existing[:amount]) %></td>
                    <td class="px-2 py-1.5 text-center text-slate-400">=</td>
                    <td class="px-2 py-1.5"><%= pair.pending.memo.presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <div class="flex flex-col gap-4 lg:flex-row lg:items-stretch">
        <div class="flex min-h-0 flex-1 flex-col rounded-lg border border-slate-200">
          <h4 class="border-b border-slate-100 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-800">保存済みの単発支出</h4>
          <div class="min-h-0 max-h-72 flex-1 overflow-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr><th class="px-3 py-2">月</th><th class="px-3 py-2">カテゴリ</th><th class="px-3 py-2 text-right">金額</th><th class="px-3 py-2">メモ</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @existing_rows.each do |row| %>
                  <tr class="<%= row[:duplicate_with_pending] ? "bg-amber-50" : "" %>">
                    <td class="px-3 py-2"><%= row[:month_label] %></td>
                    <td class="px-3 py-2">
                      <%= row[:category_path] %>
                      <% if row[:duplicate_with_pending] %>
                        <span class="ml-1 rounded bg-amber-200 px-1.5 py-0.5 text-[10px] font-medium text-amber-900">重複</span>
                      <% end %>
                    </td>
                    <td class="px-3 py-2 text-right"><%= format_yen(row[:amount]) %></td>
                    <td class="px-3 py-2"><%= row[:memo].presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%= form_with url: commit_finance_import_path, method: :post, class: "flex min-h-0 flex-1 flex-col rounded-lg border border-slate-200" do %>
          <div class="flex shrink-0 items-center justify-between border-b border-slate-100 bg-slate-50 px-3 py-2">
            <h4 class="text-sm font-medium text-slate-800">今回取り込む（単発）</h4>
          </div>
          <div class="min-h-0 max-h-72 flex-1 overflow-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="sticky top-0 bg-slate-50 text-left text-xs text-slate-500">
                <tr><th class="w-10 px-2 py-2"></th><th class="px-3 py-2">月</th><th class="px-3 py-2">カテゴリ</th><th class="px-3 py-2 text-right">金額</th><th class="px-3 py-2">メモ</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @right_table_rows.each do |row| %>
                  <tr>
                    <td class="px-2 py-2">
                      <input type="checkbox" name="line_numbers[]" value="<%= row.line_number %>" <%= @selected_line_numbers.include?(row.line_number) ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300" />
                    </td>
                    <td class="px-3 py-2"><%= row.month_label %></td>
                    <td class="px-3 py-2">
                      <select name="rows[<%= row.line_number %>][minor_category_id]" class="w-full min-w-[10rem] rounded border border-slate-300 px-2 py-1 text-xs">
                        <% @expense_minors.each do |minor| %>
                          <option value="<%= minor.id %>" <%= row.minor_category_id == minor.id ? "selected" : "" %>><%= minor.major_category.name %> / <%= minor.name %></option>
                        <% end %>
                      </select>
                    </td>
                    <td class="px-3 py-2 text-right"><%= format_yen(row.amount) %></td>
                    <td class="px-3 py-2">
                      <input type="text" name="rows[<%= row.line_number %>][memo]" value="<%= row.memo %>" maxlength="2000" class="w-full min-w-[8rem] rounded border border-slate-300 px-2 py-1 text-xs" />
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <input type="hidden" name="compare_month" value="<%= @compare_month_input %>" />
          <div class="border-t border-slate-100 p-3 text-right">
            <%= link_to "戻って修正", finance_import_path(reset: 1), class: btn_classes(:secondary) %>
            <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">選択した行を取り込む</button>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <%= form_with url: finance_import_path, method: :get, class: "flex flex-wrap items-center gap-2 text-sm" do %>
            <span class="text-slate-600">対象月</span>
            <input type="month" name="prompt_month" value="<%= @import_prompt_month %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm" onchange="this.form.requestSubmit()" />
          <% end %>
          <button type="button" class="<%= btn_classes(:secondary) %>" data-copy-text="<%= h(@claude_prompt) %>" data-copy-label="プロンプト" data-copy-flash="プロンプトをコピーしました">プロンプトコピー</button>
          <a href="https://claude.ai/new" target="_blank" rel="noopener noreferrer" class="<%= btn_classes(:link) %>">Claude</a>
        </div>
      </div>

      <%= form_with url: finance_import_path, method: :post, class: "mt-4 space-y-3" do %>
        <label class="block text-sm">
          <span class="text-slate-600">JSON</span>
          <textarea name="raw_json" rows="10" placeholder='[{"date":"<%= @import_prompt_month %>-20","month":"<%= @import_prompt_month %>","minor_category_id":<%= @expense_minors.first&.id || 1 %>,"amount":1200,"memo":"","source_id":"..."}]' class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs"><%= @raw_json %></textarea>
          <p class="mt-1 text-xs text-slate-500">検算ブロック（--- 以降）はそのまま貼り付けて OK です。</p>
        </label>
        <div class="flex justify-end gap-2">
          <%= link_to "キャンセル", finance_summary_path, class: btn_classes(:secondary) %>
          <button type="submit" class="<%= btn_classes(:primary) %> cursor-pointer">内容を確認</button>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
