<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-3">
    <h2 class="text-xl font-bold">需給/決算を分析</h2>
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
        <h3 class="text-base font-normal"><%= @watch_period_label.present? ? "監視銘柄（#{@watch_period_label}）" : "監視銘柄（本日）" %></h3>
        <span class="flex items-center gap-1.5 text-sm text-slate-500">
          <span><%= @stocks.size %>件</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </span>
      </summary>
      <div class="mt-3">
        <% if @stocks.empty? %>
          <p class="text-sm text-slate-500">対象の監視銘柄はありません</p>
        <% else %>
          <ul class="space-y-1 font-mono text-sm text-slate-800">
            <% @stocks.each do |stock| %>
              <li>
                <%= link_to stock_path(stock), class: "text-indigo-600 hover:underline" do %>
                  <%= stock.code %> <%= stock.name %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </details>
  </section>

  <%= form_with url: stock_fundamentals_path, method: :patch, class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-3" do %>
    <%= hidden_field_tag :starts_on, @watch_starts_on&.iso8601 %>
    <%= hidden_field_tag :ends_on, @watch_ends_on&.iso8601 %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-base font-semibold">プロンプト</h3>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="<%= btn_classes(:secondary) %>" data-copy-source="#stock-fundamentals-prompt" data-copy-fill-source="#stock-fundamentals-watch-stocks" data-copy-fill-token="{{WATCH_STOCKS}}" data-copy-label="プロンプトコピー" data-copy-flash="プロンプトをコピーしました">プロンプトコピー</button>
        <%= link_to "需給を取得", "https://www.jpx.co.jp/markets/statistics-equities/margin/05.html", target: "_blank", rel: "noopener noreferrer", class: btn_classes(:secondary) %>
      </div>
    </div>
    <p class="text-xs text-slate-500">
      コピー時に <code class="rounded bg-slate-100 px-1">{{WATCH_STOCKS}}</code> へ監視銘柄（コード・銘柄名）を1回だけ差し込みます。保存するのはプレースホルダ付きの本文です。
    </p>
    <%= text_area_tag "stock_fundamentals[prompt]", @prompt, id: "stock-fundamentals-prompt", rows: 26, spellcheck: false, class: "w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs leading-relaxed" %>
    <script type="application/json" id="stock-fundamentals-watch-stocks"><%= raw json_escape(@stock_list_text.to_json) %></script>
    <div class="flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-3">
      <%= submit_tag "保存", class: btn_primary_classes %>
    </div>
  <% end %>
</div>
<%= render "layouts/stock_search" %>
