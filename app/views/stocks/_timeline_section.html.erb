<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <h3 class="text-lg font-semibold">取引タイムライン</h3>
    <div class="flex flex-wrap gap-2">
      <%= link_to "エントリー", new_entry_path(stock_id: @stock.id, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id), class: btn_primary_classes %>
      <%= link_to "イグジット", new_exit_path(stock_id: @stock.id, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id), class: "rounded-lg border border-indigo-600 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50" %>
      <%= link_to "ライン設定", new_line_change_path(stock_id: @stock.id, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id), class: btn_secondary_classes %>
    </div>
  </div>

  <div class="mb-3 flex flex-wrap gap-2">
    <% timeline_tabs.each do |tab| %>
      <% active = @trade_type == tab[:trade_type] && @judgment_type == tab[:judgment_type] %>
      <%= link_to tab[:label],
                  stock_path(@stock, trade_type: tab[:trade_type], judgment_type: tab[:judgment_type], ai_script_id: (tab[:judgment_type] == "ai" ? @ai_script_id : nil)),
                  class: "rounded-full px-3 py-1.5 text-sm #{active ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
    <% end %>
  </div>

  <% if @judgment_type == "ai" && @ai_scripts.present? %>
    <%= form_with url: stock_path(@stock), method: :get, class: "mb-3 flex max-w-md flex-col gap-1 text-sm" do %>
      <%= hidden_field_tag :trade_type, @trade_type %>
      <%= hidden_field_tag :judgment_type, @judgment_type %>
      <label>
        <span class="text-slate-600">AI スクリプト</span>
        <%= select_tag :ai_script_id, options_from_collection_for_select(@ai_scripts, :id, :version_name, @ai_script_id), include_blank: "未指定", class: "mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5" %>
      </label>
      <%= submit_tag "絞り込み", class: "mt-1 w-fit rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50 cursor-pointer" %>
    <% end %>
  <% end %>

  <% if @current_position && @current_position[:shares].to_i.positive? %>
    <% pos = @current_position[:record] %>
    <div class="mb-4 rounded-lg border border-indigo-100 bg-indigo-50 p-3 text-sm">
      <div class="inline-block align-top">
        <p class="font-medium text-indigo-900">現在の保有</p>
        <p class="mt-1 text-slate-700">
          <%= format_shares(@current_position[:shares]) %>株
          / 平均取得: <%= format_decimal(@current_position[:avg_price]).presence || "—" %>
        </p>
      </div>
      <% if @current_line || pos&.current_stop.present? %>
        <span class="inline-block w-2"></span>
        <div class="inline-block align-top">
          <p class="font-medium text-indigo-900">現在のライン<%= @current_line ? "（#{@current_line.traded_at&.iso8601}）" : "" %></p>
          <p class="mt-1 text-slate-700">
            損切: <%= format_decimal(@current_line&.stop_loss || pos&.current_stop).presence || "—" %>
            / 利確: <%= format_decimal(@current_line&.take_profit || pos&.current_target).presence || "—" %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <% groups = @timeline_groups.presence || [ { position: nil, rows: @timeline_rows } ] %>
  <% if groups.all? { |g| g[:rows].blank? } %>
    <p class="text-sm text-slate-500">イベントがありません</p>
  <% else %>
    <div class="max-h-96 overflow-auto space-y-4">
      <% groups.each do |group| %>
        <% position = group[:position] %>
        <% if position %>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <% if position.open? %>
              建玉（保有中）
              <%= format_shares(position.entry_quantity).presence || "—" %>株
              / 平均取得 <%= format_decimal(position.average_cost).presence || "—" %>
              / 損切 <%= format_decimal(position.current_stop).presence || "—" %>
              / 利確 <%= format_decimal(position.current_target).presence || "—" %>
            <% else %>
              建玉（決済済）
              <% if position.r_multiple %>
                R <%= format_r_multiple(position.r_multiple) %>
              <% end %>
              / 実現損益 <%= format_decimal(position.realized_pnl).presence || "0" %>
            <% end %>
          </div>
        <% end %>
        <table class="min-w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500">
              <th class="py-2 pr-4">日付</th>
              <th class="py-2 pr-4">種別</th>
              <th class="py-2 pr-4 text-right" style="white-space: nowrap; min-width: 4.5rem">株数</th>
              <th class="py-2 pr-10 text-right" style="white-space: nowrap; min-width: 4.5rem">価格</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% group[:rows].each do |row| %>
              <tr class="border-b border-slate-100">
                <td class="py-2 pr-4 tabular-nums"><%= row.sort_on %></td>
                <td class="py-2 pr-4 whitespace-nowrap"><%= trade_kind_cell(row) %></td>
                <td class="py-2 pr-4 text-right tabular-nums whitespace-nowrap"><%= format_shares(row.record.try(:shares)).presence || "—" %></td>
                <td class="py-2 pr-10 text-right tabular-nums whitespace-nowrap"><%= trade_price_cell(row.record) %></td>
                <td class="py-2 whitespace-nowrap" style="width: 1%">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "詳細", stock_trade_event_path_for(row), class: btn_classes(:link, extra: "px-2.5 py-1 text-xs") %>
                    <%= link_to "編集", stock_trade_edit_path_for(row), class: btn_classes(:secondary, extra: "px-2.5 py-1 text-xs") %>
                    <%= button_to "削除", stock_trade_destroy_path_for(row), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger, extra: "px-2.5 py-1 text-xs") %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
</section>
