<div class="mx-auto max-w-2xl space-y-4">
  <p class="text-sm text-slate-500">
    <%= link_to "株一覧", stocks_path, class: "text-indigo-600 hover:underline" %>
    <span> / </span>
    <%= link_to @stock.name, stock_path(@stock, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id), class: "text-indigo-600 hover:underline" %>
    <span> / 銘柄設定</span>
  </p>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">銘柄設定</h2>
    <%= form_with model: @stock,
                  url: stock_path(@stock, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id),
                  method: :patch,
                  class: "mt-4 space-y-4" do |form| %>
      <label class="block text-sm">
        <span class="font-medium text-slate-700">業種</span>
        <%= form.collection_select :industry_id, @industries, :id, :name, {}, class: "mt-1 w-full max-w-md rounded-lg border border-slate-300 px-3 py-2" %>
      </label>
      <p class="text-xs text-slate-500">
        <%= link_to "業種を追加", industries_path, class: btn_classes(:link, extra: "px-2.5 py-1 text-xs") %>
      </p>

      <label class="block text-sm">
        <span class="font-medium text-slate-700">銘柄メモ</span>
        <%= form.text_area :memo, rows: 8, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
      </label>

      <div class="flex flex-wrap gap-2">
        <%= form.submit "保存", class: btn_primary_classes %>
        <%= link_to "キャンセル", stock_path(@stock, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id), class: btn_secondary_classes %>
      </div>
    <% end %>
  </section>
</div>
