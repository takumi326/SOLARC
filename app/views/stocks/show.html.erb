<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex flex-wrap items-center gap-2 text-xl font-bold">
          <span>
            <%= @stock.code %> <%= @stock.name %>（<%= @stock.industry.name %>）
          </span>
          <% holding = @current_position && @current_position[:shares].to_i.positive? %>
          <% if holding %>
            <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">エントリー中</span>
          <% elsif @stock.currently_watched? %>
            <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">監視中</span>
          <% end %>
        </h2>
      </div>
      <a href="<%= @stock.tradingview_url %>" target="_blank" rel="noreferrer" class="rounded-lg bg-slate-900 px-3 py-2 text-sm text-white hover:bg-slate-800">
        チャート
      </a>
    </div>

    <div class="mt-4 rounded-lg bg-slate-50 p-3 text-sm">
      <div class="mb-1 flex items-center justify-between gap-2">
        <span class="font-medium text-slate-700">銘柄設定</span>
        <%= link_to "編集",
                    edit_stock_path(@stock, trade_type: @trade_type, judgment_type: @judgment_type, ai_script_id: @ai_script_id),
                    class: btn_classes(:secondary, extra: "px-2.5 py-1 text-xs") %>
      </div>
      <dl class="grid gap-1 text-slate-700">
        <div class="flex gap-2">
          <dt class="text-slate-500">メモ</dt>
          <dd class="min-w-0 flex-1 whitespace-pre-wrap"><%= @stock.memo.to_s.strip.present? ? @stock.memo : "（未入力）" %></dd>
        </div>
      </dl>
    </div>

    <div class="mt-4 rounded-lg border border-slate-200 bg-white p-3 text-sm">
      <div class="mb-2 flex items-center justify-between gap-2">
        <span class="font-medium text-slate-700">監視期間</span>
        <%= link_to "追加", new_stock_stock_watch_period_path(@stock), class: btn_classes(:link, extra: "px-2.5 py-1 text-xs") %>
      </div>
      <% if @watch_items.any? %>
        <ul class="space-y-2">
          <% @watch_items.each do |item| %>
            <li class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-slate-800"><%= item.stock_watch_batch.watch_period_label %></span>
              <div class="flex flex-wrap items-center gap-2">
                <%= link_to "編集", edit_stock_stock_watch_period_path(@stock, item), class: btn_classes(:secondary, extra: "px-2.5 py-1 text-xs") %>
                <%= button_to "削除", stock_stock_watch_period_path(@stock, item),
                      method: :delete,
                      form: { data: { turbo_confirm: "この監視期間を削除しますか？" }, class: "inline" },
                      class: btn_classes(:danger, extra: "px-2.5 py-1 text-xs") %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-slate-500">まだありません</p>
      <% end %>
    </div>
  </section>

  <%= render "timeline_section" %>
</div>
