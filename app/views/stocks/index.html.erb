<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">株一覧</h2>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "業種を管理", industries_path, class: btn_secondary_classes %>
        <%= link_to "銘柄取込", new_import_stocks_path, class: btn_secondary_classes %>
        <%= link_to "監視銘柄取込", new_stock_watchlist_path, class: btn_secondary_classes %>
      </div>
    </div>

    <div class="mb-4 flex flex-wrap items-end gap-3">
      <%= form_with url: stocks_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
        <%= text_field_tag :q, @q, class: "w-56 rounded-lg border border-slate-300 px-2 py-1.5 text-sm", placeholder: "コード・銘柄名で検索", aria: { label: "コード・銘柄名で検索" } %>
        <div class="flex items-center gap-3 text-sm">
          <label class="inline-flex items-center gap-1.5">
            <%= hidden_field_tag :watch, "0", id: nil %>
            <%= check_box_tag :watch, "1", @watch, id: "stock_filter_watch" %>
            <span>監視</span>
          </label>
          <label class="inline-flex items-center gap-1.5">
            <%= hidden_field_tag :entry, "0", id: nil %>
            <%= check_box_tag :entry, "1", @entry, id: "stock_filter_entry" %>
            <span>エントリー</span>
          </label>
          <label class="inline-flex items-center gap-1.5">
            <%= hidden_field_tag :virtual, "0", id: nil %>
            <%= check_box_tag :virtual, "1", @virtual, id: "stock_filter_virtual" %>
            <span>仮想エントリー</span>
          </label>
        </div>
        <div class="flex items-center gap-1.5 text-sm">
          <%= date_field_tag :period_starts_on, @period_starts_on&.iso8601, class: "rounded-lg border border-slate-300 px-2 py-1.5 text-sm", aria: { label: "期間の開始日" } %>
          <span class="text-slate-400">〜</span>
          <%= date_field_tag :period_ends_on, @period_ends_on&.iso8601, class: "rounded-lg border border-slate-300 px-2 py-1.5 text-sm", aria: { label: "期間の終了日" } %>
        </div>
        <%= submit_tag "絞り込み", class: "rounded-lg bg-slate-800 px-3 py-1.5 text-sm text-white hover:bg-slate-700 cursor-pointer" %>
        <% if @searching || !@watch || !@entry || !@virtual || @period_starts_on || @period_ends_on %>
          <%= link_to "クリア", stocks_path, class: btn_secondary_classes %>
        <% end %>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500">
            <th class="py-2 pr-3 text-center">監視</th>
            <th class="py-2 pr-3 text-center">エントリー</th>
            <th class="py-2 pr-3">コード</th>
            <th class="py-2 pr-3">銘柄名</th>
            <th class="py-2 pr-3">業種</th>
            <th class="py-2 pr-3 text-right">保有株数（実）</th>
            <th class="py-2 pr-3">チャート</th>
            <th class="py-2 pr-3">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @stocks.each do |stock| %>
            <% flags = @stock_flags.fetch(stock.id, { watched: false, entered: false }) %>
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-3 text-center">
                <% if flags[:watched] %>
                  <span class="font-semibold text-emerald-600" title="<%= @period_active ? "期間内に監視" : "監視中" %>">○</span>
                <% else %>
                  <span class="text-slate-300" title="<%= @period_active ? "期間内に監視なし" : "監視なし" %>">—</span>
                <% end %>
              </td>
              <td class="py-2 pr-3 text-center">
                <% if flags[:entered] %>
                  <span class="font-semibold text-indigo-600" title="<%= @period_active ? "期間内にエントリー" : "エントリーあり" %>">○</span>
                <% else %>
                  <span class="text-slate-300" title="<%= @period_active ? "期間内にエントリーなし" : "エントリーなし" %>">—</span>
                <% end %>
              </td>
              <td class="py-2 pr-3 font-mono"><%= stock.code %></td>
              <td class="py-2 pr-3 font-medium"><%= stock.name %></td>
              <td class="py-2 pr-3 text-slate-600"><%= stock.industry.name %></td>
              <td class="py-2 pr-3 text-right tabular-nums"><%= stock.holding_shares_real %></td>
              <td class="py-2 pr-3">
                <a href="<%= stock.tradingview_url %>" target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">TradingView</a>
              </td>
              <td class="py-2 pr-3">
                <%= link_to "詳細", stock_path(stock), class: "inline-flex items-center justify-center rounded-md border border-indigo-200 bg-white px-2.5 py-1 text-xs font-medium text-indigo-700 hover:bg-indigo-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @stocks.empty? %>
        <p class="py-6 text-center text-sm text-slate-500">
          <% if !@watch && !@entry && !@virtual %>
            監視・エントリー・仮想エントリーのいずれかを選んでください
          <% elsif @searching %>
            「<%= @q %>」に一致する銘柄はありません
          <% elsif @period_active %>
            この期間に該当する銘柄がありません
          <% else %>
            該当する銘柄がありません
          <% end %>
        </p>
      <% end %>
    </div>
  </section>
</div>
