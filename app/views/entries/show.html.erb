<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h2 class="text-xl font-bold"><%= stock_event_heading(@stock, "エントリー詳細") %></h2>
      <div class="flex flex-wrap gap-2">
        <%= link_to "株詳細へ", stock_timeline_path_for_record(@entry), class: btn_secondary_classes %>
        <%= link_to "編集", edit_entry_path(@entry), class: btn_classes(:secondary) %>
        <%= button_to "削除", entry_path(@entry), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger) %>
      </div>
    </div>
    <dl class="mt-4 divide-y divide-slate-100 text-sm">
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">エントリー理由</dt>
        <dd class="whitespace-pre-wrap text-slate-900"><%= @entry.entry_reason %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">シナリオ</dt>
        <dd class="whitespace-pre-wrap text-slate-900"><%= @entry.scenario.presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">株数</dt>
        <dd class="text-slate-900"><%= format_shares(@entry.shares).presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">予定価格</dt>
        <dd class="text-slate-900"><%= format_decimal(@entry.expected_price).presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">約定価格</dt>
        <dd class="text-slate-900"><%= format_decimal(@entry.actual_price).presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">約定日</dt>
        <dd class="text-slate-900"><%= format_date_value(@entry.traded_at).presence || "未約定" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">メモ</dt>
        <dd class="whitespace-pre-wrap text-slate-900"><%= @entry.memo.presence || "—" %></dd>
      </div>
    </dl>
  </section>
</div>
