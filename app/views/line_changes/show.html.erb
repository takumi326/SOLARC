<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h2 class="text-xl font-bold"><%= stock_event_heading(@stock, "ライン設定詳細") %></h2>
      <div class="flex flex-wrap gap-2">
        <%= link_to "株詳細へ", stock_timeline_path_for_record(@line_change), class: btn_secondary_classes %>
        <%= link_to "編集", edit_line_change_path(@line_change), class: btn_classes(:secondary) %>
        <%= button_to "削除", line_change_path(@line_change), method: :delete, form: { data: { turbo_confirm: "削除しますか？" }, class: "inline" }, class: btn_classes(:danger) %>
      </div>
    </div>
    <dl class="mt-4 divide-y divide-slate-100 text-sm">
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">変更日</dt>
        <dd class="text-slate-900"><%= format_date_value(@line_change.changed_on) %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">損切</dt>
        <dd class="text-slate-900"><%= format_decimal(@line_change.stop_loss).presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">利確</dt>
        <dd class="text-slate-900"><%= format_decimal(@line_change.target_price).presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-[7.5rem_1fr] gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr]">
        <dt class="font-medium text-slate-600">理由</dt>
        <dd class="whitespace-pre-wrap text-slate-900"><%= @line_change.reason.presence || "—" %></dd>
      </div>
    </dl>
  </section>
</div>
