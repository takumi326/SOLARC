<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold"><%= stock_event_heading(@stock, "ライン設定を編集") %></h2>
    <div style="height: 2rem"></div>
    <%= render "form",
               record: @line_change,
               stock: @stock,
               trade_type: @trade_type,
               judgment_type: @judgment_type,
               ai_script_id: @ai_script_id,
               ai_scripts: @ai_scripts,
               form_url: line_change_path(@line_change),
               form_method: :patch,
               submit_label: "保存" %>
  </section>
</div>
