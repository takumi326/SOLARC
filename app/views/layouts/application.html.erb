<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>Solarc</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "/favicon.png", type: "image/png" %>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "clipboard", defer: true %>
    <%= javascript_include_tag "mobile_nav", defer: true %>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <div id="mobile-nav-overlay" class="fixed inset-0 z-40 hidden bg-black/40 md:hidden" aria-hidden="true"></div>

    <aside
      id="mobile-nav-drawer"
      class="fixed inset-y-0 left-0 z-50 flex w-64 max-w-[85vw] -translate-x-full flex-col border-r border-slate-200 bg-white shadow-xl transition-transform duration-200 ease-out md:hidden"
      aria-label="メインメニュー"
    >
      <div class="overflow-y-auto p-4 pt-5">
        <%= render "layouts/sidebar_nav" %>
      </div>
    </aside>

    <button
      type="button"
      id="mobile-nav-open"
      class="fixed left-3 top-3 z-30 inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white/95 px-2.5 py-2 text-slate-800 shadow-lg ring-1 ring-black/5 backdrop-blur-sm hover:bg-slate-50 md:hidden"
      aria-label="メニューを開く"
    >
      <span class="text-lg leading-none" aria-hidden="true">≡</span>
    </button>

    <div class="mx-auto min-h-screen w-full max-w-7xl p-3 sm:p-6">
      <div class="grid gap-4 md:grid-cols-[220px_1fr] md:items-start">
        <aside class="hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:sticky md:top-6 md:block md:h-[calc(100vh-3rem)] md:overflow-y-auto">
          <%= render "layouts/sidebar_nav" %>
        </aside>

        <section class="min-w-0">
          <% if flash[:notice].present? %>
            <p class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800"><%= flash[:notice] %></p>
          <% end %>
          <% if flash[:alert].present? %>
            <p class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"><%= flash[:alert] %></p>
          <% end %>
          <%= yield %>
        </section>
      </div>
    </div>
    <div id="js-copy-toast" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 hidden justify-center px-4 opacity-0 transition-opacity duration-200" aria-live="polite">
      <p id="js-copy-toast-message" class="pointer-events-auto rounded-xl border border-emerald-200 bg-white px-4 py-3 text-sm font-medium text-emerald-800 shadow-lg ring-1 ring-black/5"></p>
    </div>
  </body>
</html>
