<div class="mx-auto max-w-2xl space-y-4">
  <p class="text-sm text-slate-500">
    <%= link_to "株一覧", stocks_path, class: "text-indigo-600 hover:underline" %>
    <span> / </span>
    <%= link_to @stock.name, stock_path(@stock), class: "text-indigo-600 hover:underline" %>
    <span> / 監視期間を追加</span>
  </p>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">監視期間を追加</h2>
    <p class="mt-1 text-sm text-slate-600"><%= @stock.code %> <%= @stock.name %></p>

    <%= form_with url: stock_stock_watch_periods_path(@stock), method: :post, class: "mt-4 space-y-4" do %>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">監視開始</span>
          <%= date_field_tag :starts_on, @starts_on.iso8601, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">監視終了</span>
          <%= date_field_tag :ends_on, @ends_on.iso8601, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </label>
      </div>

      <%= submit_tag "追加", class: btn_classes(:primary) %>
    <% end %>
  </section>
</div>
