<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold">監視銘柄リストを取込</h2>
      <%= link_to "株一覧へ戻る", stocks_path, class: btn_classes(:secondary) %>
    </div>

    <p class="mb-4 text-sm text-slate-600">
      TradingView のリスト（例: <code class="rounded bg-slate-100 px-1">TSE:2871,TSE:5444</code>）を複数ファイルまとめて取り込めます。
      ファイル名の戦略名（押し目・高値ブレイクなど）も記録します。
    </p>

    <%= form_with url: stock_watchlists_path, method: :post, multipart: true, class: "space-y-4" do %>
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">取込日</span>
          <%= date_field_tag :imported_on, @imported_on.iso8601, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">監視開始</span>
          <%= date_field_tag :starts_on, @starts_on.iso8601, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">監視終了</span>
          <%= date_field_tag :ends_on, @ends_on.iso8601, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </label>
      </div>

      <div class="space-y-2 text-sm">
        <span class="font-medium text-slate-700">リストファイル（複数可）</span>
        <div class="flex flex-wrap items-center gap-3" data-file-picker>
          <%= file_field_tag :files,
                multiple: true,
                accept: ".txt,text/plain",
                class: "hidden",
                style: "display:none;",
                data: { file_picker_input: true } %>
          <button type="button" class="<%= btn_classes(:secondary) %>" data-file-picker-trigger>
            TXTを選択
          </button>
          <span class="text-sm text-slate-500" data-file-picker-name>選択されていません</span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= submit_tag "アップロード", class: btn_classes(:primary) %>
      </div>
    <% end %>
  </section>
</div>

<script>
  document.querySelectorAll("[data-file-picker]").forEach(function (root) {
    var input = root.querySelector("[data-file-picker-input]")
    var trigger = root.querySelector("[data-file-picker-trigger]")
    var name = root.querySelector("[data-file-picker-name]")
    if (!input || !trigger || !name) return

    trigger.addEventListener("click", function () {
      input.click()
    })

    input.addEventListener("change", function () {
      var files = input.files ? Array.prototype.slice.call(input.files) : []
      if (files.length === 0) {
        name.textContent = "選択されていません"
      } else if (files.length === 1) {
        name.textContent = files[0].name
      } else {
        name.textContent = files.length + "件: " + files.map(function (f) { return f.name }).join(", ")
      }
    })
  })
</script>
