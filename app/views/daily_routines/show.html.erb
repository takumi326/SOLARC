<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">日課</h2>
        <p class="mt-1 text-sm text-slate-500"><%= @date.strftime("%Y/%m/%d") %>（<%= %w[日 月 火 水 木 金 土][@date.wday] %>）</p>
      </div>
      <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      <% @slots.each do |slot| %>
        <article class="rounded-xl border p-4 <%= slot.emphasized ? 'border-indigo-300 bg-indigo-50/40' : 'border-slate-200 bg-slate-50/50 opacity-90' %>">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-slate-900"><%= slot.label %></h3>
            <% if slot.completed %>
              <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">完了</span>
            <% else %>
              <span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-medium text-slate-600">未完了</span>
            <% end %>
          </div>

          <ol class="list-decimal space-y-1.5 pl-5 text-sm text-slate-700">
            <% slot.items.each do |item| %>
              <li><%= item.label %></li>
            <% end %>
          </ol>

          <div class="mt-4">
            <% if slot.slot == "holiday" %>
              <%= link_to "エントリー登録へ", new_entry_path, class: btn_classes(:link) %>
            <% else %>
              <%= link_to "毎日の記録へ", stock_daily_notes_path, class: btn_classes(:link) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</div>
