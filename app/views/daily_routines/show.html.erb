<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">ルーチン</h2>
        <p class="mt-1 text-sm text-slate-500"><%= @date.strftime("%Y/%m/%d") %>（<%= %w[日 月 火 水 木 金 土][@date.wday] %>）</p>
      </div>
      <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      <% @slots.each do |slot| %>
        <%
          card_classes =
            if slot.completed
              "border-emerald-400 bg-emerald-50 ring-1 ring-emerald-200"
            elsif slot.emphasized
              "border-indigo-300 bg-indigo-50/40"
            else
              "border-slate-200 bg-slate-50/50 opacity-80"
            end
        %>
        <article class="rounded-xl border p-4 <%= card_classes %>">
          <div class="mb-3 flex items-start justify-between gap-2">
            <h3 class="text-base font-semibold text-slate-900"><%= slot.label %></h3>
            <% if slot.completed %>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white">
                <span aria-hidden="true">✓</span> 完了
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-700 px-2.5 py-1 text-xs font-semibold text-white">
                未完了
              </span>
            <% end %>
          </div>

          <p class="mb-3 rounded-lg px-2.5 py-2 text-xs leading-relaxed <%= slot.completed ? 'bg-emerald-100/80 text-emerald-900' : 'bg-white/80 text-slate-600' %>">
            <% if slot.completed %>
              条件クリア：<%= slot.completion_hint.sub(/と完了\z/, "") %>
            <% else %>
              <%= slot.completion_hint %>
            <% end %>
          </p>

          <ol class="space-y-2 text-sm text-slate-700">
            <% slot.items.each_with_index do |item, index| %>
              <li class="leading-relaxed">
                <span class="font-medium text-slate-500"><%= index + 1 %>.</span>
                <%= item.label %>
              </li>
            <% end %>
          </ol>

          <div class="mt-4">
            <% if slot.completed %>
              <p class="text-xs font-medium text-emerald-700">この枠は完了済みです</p>
            <% elsif slot.slot == "holiday" %>
              <%= link_to "エントリーを登録して完了にする →", new_entry_path, class: btn_classes(:primary) %>
            <% else %>
              <%= link_to "毎日の記録を書いて完了にする →", stock_daily_notes_path, class: btn_classes(:primary) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</div>
