<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">ルーチン</h2>
        <p class="mt-1 text-sm text-slate-500"><%= @date.strftime("%Y/%m/%d") %>（<%= %w[日 月 火 水 木 金 土][@date.wday] %>）</p>
      </div>
      <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
    </div>

    <div class="grid gap-4 lg:grid-cols-[minmax(260px,300px)_1fr] lg:items-start">
      <aside class="space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:p-4">
        <%= form_with url: daily_routine_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2" do %>
          <div class="min-w-0 flex-1">
            <label for="routine_date" class="mb-1 block text-xs font-medium text-slate-600">日付を選ぶ</label>
            <input id="routine_date" type="date" name="date" value="<%= @date.iso8601 %>" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
          </div>
          <button type="submit" class="<%= btn_classes(:secondary) %>">表示</button>
        <% end %>

        <div class="flex items-center justify-between gap-2">
          <%= link_to "←", daily_routine_path(date: @date.iso8601, month: @calendar.prev_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
          <p class="text-sm font-semibold text-slate-800"><%= @calendar.month.strftime("%Y年%-m月") %></p>
          <%= link_to "→", daily_routine_path(date: @date.iso8601, month: @calendar.next_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
        </div>

        <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-medium text-slate-500">
          <% %w[日 月 火 水 木 金 土].each do |wday| %>
            <div class="py-1"><%= wday %></div>
          <% end %>
        </div>

        <div class="grid grid-cols-7 gap-1">
          <% @calendar.weeks.each do |week| %>
            <% week.each do |cell| %>
              <%
                base = "flex aspect-square items-center justify-center rounded-lg text-sm font-medium transition"
                tone =
                  case cell.status
                  when :complete then "bg-emerald-500 text-white hover:bg-emerald-600"
                  when :partial then "bg-amber-200 text-amber-950 hover:bg-amber-300"
                  when :incomplete then "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
                  when :none then "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
                  else "bg-transparent text-slate-300"
                  end
                selected = cell.selected ? " ring-2 ring-indigo-500 ring-offset-1" : ""
                today = cell.today && !cell.selected ? " outline outline-1 outline-offset-[-1px] outline-indigo-300" : ""
              %>
              <% if cell.in_month %>
                <%= link_to cell.date.day,
                      daily_routine_path(date: cell.date.iso8601, month: @calendar.month.strftime("%Y-%m")),
                      class: "#{base} #{tone}#{selected}#{today}",
                      aria: { current: (cell.selected ? "date" : nil), label: "#{cell.date.strftime("%Y/%m/%d")} #{cell.status}" } %>
              <% else %>
                <span class="<%= base %> <%= tone %>"><%= cell.date.day %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <ul class="space-y-1 text-[11px] text-slate-500">
          <li><span class="mr-1 inline-block h-2.5 w-2.5 rounded-sm bg-emerald-500"></span>対象枠すべて完了</li>
          <li><span class="mr-1 inline-block h-2.5 w-2.5 rounded-sm bg-amber-200"></span>一部完了</li>
          <li><span class="mr-1 inline-block h-2.5 w-2.5 rounded-sm border border-slate-300 bg-white"></span>未完了</li>
        </ul>

        <% unless @date == Date.current %>
          <div>
            <%= link_to "今日へ戻る", daily_routine_path, class: btn_classes(:link) %>
          </div>
        <% end %>
      </aside>

      <div class="grid gap-4 lg:grid-cols-3">
        <% @slots.each do |slot| %>
          <%
            card_classes =
              if slot.completed
                "border-emerald-400 bg-emerald-50 ring-1 ring-emerald-200"
              elsif slot.emphasized
                "border-indigo-300 bg-indigo-50/40"
              else
                "border-slate-200 bg-slate-50/50 opacity-80"
              end
          %>
          <article class="rounded-xl border p-4 <%= card_classes %>">
            <div class="mb-3 flex items-start justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-900"><%= slot.label %></h3>
              <% if slot.completed %>
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white">
                  <span aria-hidden="true">✓</span> 完了
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-700 px-2.5 py-1 text-xs font-semibold text-white">
                  未完了
                </span>
              <% end %>
            </div>

            <p class="mb-3 rounded-lg px-2.5 py-2 text-xs leading-relaxed <%= slot.completed ? 'bg-emerald-100/80 text-emerald-900' : 'bg-white/80 text-slate-600' %>">
              <% if slot.completed %>
                条件クリア：<%= slot.completion_hint.sub(/と完了\z/, "") %>
              <% else %>
                <%= slot.completion_hint %>
              <% end %>
            </p>

            <ol class="space-y-2 text-sm text-slate-700">
              <% slot.items.each_with_index do |item, index| %>
                <li class="leading-relaxed">
                  <span class="font-medium text-slate-500"><%= index + 1 %>.</span>
                  <%= item.label %>
                </li>
              <% end %>
            </ol>

            <div class="mt-4">
              <% if slot.completed %>
                <p class="text-xs font-medium text-emerald-700">この枠は完了済みです</p>
              <% elsif slot.slot == "holiday" %>
                <%= link_to "エントリーを登録して完了にする →", new_entry_path, class: btn_classes(:primary) %>
              <% else %>
                <%= link_to "毎日の記録を書いて完了にする →", stock_daily_notes_path, class: btn_classes(:primary) %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
</div>
