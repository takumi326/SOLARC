<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold">ルーチン</h2>
        <p class="mt-1 text-sm text-slate-500"><%= @date.strftime("%Y/%m/%d") %>（<%= %w[日 月 火 水 木 金 土][@date.wday] %>）</p>
      </div>
      <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
    </div>

    <div class="mb-6 grid gap-4 lg:grid-cols-3">
      <% @slots.each do |slot| %>
        <%
          card_classes =
            if slot.completed
              "border-emerald-400 bg-emerald-50 ring-1 ring-emerald-200"
            elsif slot.emphasized
              "border-indigo-300 bg-indigo-50/40"
            else
              "border-slate-200 bg-slate-50/50 opacity-80"
            end
        %>
        <article class="rounded-xl border p-4 <%= card_classes %>">
          <div class="mb-3 flex items-start justify-between gap-2">
            <h3 class="text-base font-semibold text-slate-900"><%= slot.label %></h3>
            <% if slot.completed %>
              <span class="inline-flex shrink-0 items-center gap-1 rounded-md px-3 py-1.5 text-sm font-bold tracking-wide text-white shadow-sm" style="background-color:#059669;">
                <span aria-hidden="true">✓</span>完了
              </span>
            <% else %>
              <span class="inline-flex shrink-0 items-center rounded-md px-3 py-1.5 text-sm font-bold tracking-wide text-white shadow-sm" style="background-color:#e11d48;">
                未完了
              </span>
            <% end %>
          </div>

          <p class="mb-3 rounded-lg px-2.5 py-2 text-xs font-medium leading-relaxed" style="<%= slot.completed ? 'background-color:#d1fae5;color:#065f46;border:1px solid #34d399;' : 'background-color:#ffffff;color:#334155;border:1px solid #94a3b8;' %>">
            完了条件：<%= slot.completion_hint %>
          </p>

          <ol class="space-y-2 text-sm text-slate-700">
            <% slot.items.each_with_index do |item, index| %>
              <li class="leading-relaxed">
                <span class="font-medium text-slate-500"><%= index + 1 %>.</span>
                <%= item.label %>
              </li>
            <% end %>
          </ol>

          <div class="mt-4">
            <% if slot.completed %>
              <p class="text-xs font-medium text-emerald-700">この枠は完了済みです</p>
            <% elsif slot.slot == "holiday" %>
              <%= link_to "エントリーを登録して完了にする →", new_entry_path, class: btn_classes(:primary) %>
            <% else %>
              <%= link_to "毎日の記録を書いて完了にする →", stock_daily_notes_path, class: btn_classes(:primary) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 sm:p-4">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
        <%= form_with url: daily_routine_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2" do %>
          <div>
            <label for="routine_date" class="mb-1 block text-xs font-medium text-slate-600">日付を選ぶ</label>
            <input id="routine_date" type="date" name="date" value="<%= @date.iso8601 %>" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
          </div>
          <button type="submit" class="<%= btn_classes(:secondary) %>">表示</button>
        <% end %>

        <% unless @date == Date.current %>
          <%= link_to "今日へ戻る", daily_routine_path, class: btn_classes(:link) %>
        <% end %>
      </div>

      <div class="mb-2 flex items-center justify-between gap-2">
        <%= link_to "←", daily_routine_path(date: @date.iso8601, month: @calendar.prev_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
        <p class="text-sm font-semibold text-slate-800"><%= @calendar.month.strftime("%Y年%-m月") %></p>
        <%= link_to "→", daily_routine_path(date: @date.iso8601, month: @calendar.next_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
      </div>

      <table class="w-full table-fixed border-collapse text-center text-sm">
        <thead>
          <tr class="text-xs font-medium text-slate-500">
            <% %w[日 月 火 水 木 金 土].each do |wday| %>
              <th scope="col" class="px-0.5 py-1 font-medium"><%= wday %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @calendar.weeks.each do |week| %>
            <tr>
              <% week.each do |cell| %>
                <%
                  cell_style =
                    case cell.status
                    when :complete
                      "background-color:#059669;color:#ffffff;border:1px solid #047857;"
                    when :partial
                      "background-color:#fbbf24;color:#78350f;border:1px solid #d97706;"
                    when :incomplete, :none
                      "background-color:#ffffff;color:#334155;border:1px solid #cbd5e1;"
                    else
                      "background-color:transparent;color:#cbd5e1;border:1px solid transparent;"
                    end
                  if cell.selected
                    cell_style += "outline:3px solid #4f46e5;outline-offset:1px;"
                  elsif cell.today
                    cell_style += "outline:2px solid #818cf8;outline-offset:1px;"
                  end
                %>
                <td class="p-0.5 align-middle">
                  <% if cell.in_month %>
                    <%= link_to daily_routine_path(date: cell.date.iso8601, month: @calendar.month.strftime("%Y-%m")),
                          class: "mx-auto flex h-10 w-full flex-col items-center justify-center rounded-lg text-sm font-bold no-underline",
                          style: cell_style,
                          aria: { current: (cell.selected ? "date" : false), label: "#{cell.date.strftime("%Y/%m/%d")} #{cell.status}" } do %>
                      <span><%= cell.date.day %></span>
                      <% if cell.status == :complete %>
                        <span style="font-size:10px;line-height:1;">✓</span>
                      <% end %>
                    <% end %>
                  <% else %>
                    <span class="mx-auto flex h-10 w-full items-center justify-center text-sm" style="color:#cbd5e1;"><%= cell.date.day %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="mt-3 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold text-white" style="background-color:#059669;">すべて完了</span>
        <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold" style="background-color:#fbbf24;color:#78350f;">一部完了</span>
        <span class="inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-bold text-slate-700" style="background-color:#ffffff;border-color:#cbd5e1;">未完了</span>
      </div>
    </div>
  </section>
</div>
