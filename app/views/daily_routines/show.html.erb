<style>
  .routine-layout { display: grid; gap: 1rem; }
  .routine-cards { display: grid; gap: 1rem; align-content: start; }
  @media (min-width: 640px) {
    .routine-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .routine-layout { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
    .routine-calendar { position: sticky; top: 1rem; }
  }
</style>

<% visible_slots = @slots.select(&:emphasized) %>

<div id="daily-routine-root" class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-xl font-bold leading-none">ルーチン</h2>

        <%= form_with url: daily_routine_path, method: :get, local: true, class: "flex items-center" do %>
          <input id="routine_date" type="date" name="date" value="<%= @date.iso8601 %>" aria-label="日付を選ぶ" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
        <% end %>

        <% if @weekend %>
          <span class="inline-flex items-center rounded-lg border border-slate-300 bg-slate-100 px-3 py-1.5 text-sm text-slate-600">土日は休み</span>
        <% elsif @marked_off %>
          <%= button_to "休みを解除", off_days_daily_routine_path(date: @date.iso8601), method: :delete, class: btn_classes(:secondary) %>
        <% else %>
          <%= button_to "この日を休みにする", off_days_daily_routine_path(date: @date.iso8601), method: :post, class: btn_classes(:secondary) %>
        <% end %>

        <% if @off_day %>
          <%= link_to "株一覧へ →", stocks_path, class: btn_classes(:primary) %>
        <% elsif visible_slots.any? { |slot| !slot.completed } %>
          <%= link_to "毎日の記録を書く →", stock_daily_notes_path, class: btn_classes(:primary) %>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "今日", daily_routine_path, class: btn_classes(:primary), data: { routine_link: true } %>
        <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
      </div>
    </div>

    <div class="routine-layout">
      <div>
        <div class="routine-cards">
        <% visible_slots.each do |slot| %>
          <%
            holiday_slot = slot.slot == "holiday"
            card_style =
              if slot.completed
                "border:2px solid #059669;background-color:#ecfdf5;"
              elsif holiday_slot
                "border:2px solid #7c3aed;background-color:#f5f3ff;"
              else
                "border:2px solid #2563eb;background-color:#eff6ff;"
              end
            status_style =
              if slot.completed
                "background-color:#059669;color:#ffffff;"
              elsif holiday_slot
                "background-color:#7c3aed;color:#ffffff;"
              else
                "background-color:#e11d48;color:#ffffff;"
              end
            condition_style =
              if slot.completed
                "background-color:#ffffff;color:#065f46;border:1px solid #059669;"
              elsif holiday_slot
                "background-color:#ffffff;color:#5b21b6;border:1px solid #a78bfa;"
              else
                "background-color:#ffffff;color:#0f172a;border:1px solid #64748b;"
              end
          %>
          <article class="overflow-hidden rounded-xl" style="<%= card_style %>">
            <div class="flex items-center justify-between gap-2 px-4 py-2" style="<%= status_style %>">
              <h3 class="text-base font-bold"><%= slot.label %></h3>
              <span class="text-sm font-bold tracking-wide">
                <% if slot.completed %>✓ 完了<% else %>未完了<% end %>
              </span>
            </div>

            <div class="p-4">
              <p class="mb-3 rounded-lg px-3 py-2 text-sm font-medium leading-relaxed" style="<%= condition_style %>">
                完了条件：<%= slot.completion_hint %>
              </p>

              <ol class="space-y-2 text-sm text-slate-800">
                <% slot.items.each_with_index do |item, index| %>
                  <li class="leading-relaxed">
                    <span class="font-semibold text-slate-500"><%= index + 1 %>.</span>
                    <%= item.label %>
                  </li>
                <% end %>
              </ol>
            </div>
          </article>
        <% end %>

        <% if @off_day %>
          <aside class="overflow-hidden rounded-xl" style="border:2px solid #7c3aed;background-color:#faf5ff;">
            <div class="px-4 py-2" style="background-color:#7c3aed;color:#ffffff;">
              <h3 class="text-base font-bold">エントリー予定</h3>
            </div>
            <div class="p-4">
              <% if @holiday_entry_plans.present? %>
                <ul class="space-y-2">
                  <% @holiday_entry_plans.each do |entry| %>
                    <li>
                      <%= link_to stock_timeline_path_for_record(entry),
                            class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm no-underline hover:opacity-90",
                            style: "background-color:#ffffff;border:1px solid #c4b5fd;color:#1e1b4b;" do %>
                        <span class="font-mono font-semibold" style="color:#6d28d9;"><%= entry.stock.code %></span>
                        <span class="font-medium"><%= entry.stock.name %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-sm text-slate-600">まだありません。銘柄を選んでエントリーを登録するとここに出ます。</p>
              <% end %>
            </div>
          </aside>
        <% end %>
        </div>
      </div>

      <div class="routine-calendar rounded-xl border border-slate-200 bg-slate-50 p-3 sm:p-4">
        <div class="mb-2 flex items-center justify-between gap-2">
          <%= link_to "←", daily_routine_path(date: @date.iso8601, month: @calendar.prev_month.strftime("%Y-%m")), class: btn_classes(:secondary), data: { routine_link: true } %>
          <p class="text-sm font-semibold text-slate-800"><%= @calendar.month.strftime("%Y年%-m月") %></p>
          <%= link_to "→", daily_routine_path(date: @date.iso8601, month: @calendar.next_month.strftime("%Y-%m")), class: btn_classes(:secondary), data: { routine_link: true } %>
        </div>

        <div class="mb-2 flex flex-wrap items-center text-xs text-slate-700" style="gap:8px 16px;">
          <span class="inline-flex items-center" style="gap:6px;">
            <span class="inline-block h-4 w-4 shrink-0 rounded" style="background-color:#059669;"></span>完了
          </span>
          <span class="inline-flex items-center" style="gap:6px;">
            <span class="inline-block h-4 w-4 shrink-0 rounded" style="background-color:#f59e0b;"></span>一部
          </span>
          <span class="inline-flex items-center" style="gap:6px;">
            <span class="inline-block h-4 w-4 shrink-0 rounded" style="background-color:#ffffff;border:1px solid #94a3b8;"></span>未完了
          </span>
          <span class="inline-flex items-center" style="gap:6px;">
            <span class="inline-block h-4 w-4 shrink-0 rounded" style="background-color:#ffffff;border:3px solid #7c3aed;"></span>休み
          </span>
        </div>

        <table class="w-full table-fixed border-collapse text-center text-sm">
          <thead>
            <tr class="text-xs font-medium text-slate-500">
              <% %w[日 月 火 水 木 金 土].each do |wday| %>
                <th scope="col" class="px-0.5 py-1 font-medium"><%= wday %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @calendar.weeks.each do |week| %>
              <tr>
                <% week.each do |cell| %>
                  <%
                    # 背景 = 完了状態 / 紫の太枠 = 休み
                    cell_style =
                      case cell.status
                      when :complete
                        "background-color:#059669;color:#ffffff;"
                      when :partial
                        "background-color:#f59e0b;color:#ffffff;"
                      when :incomplete, :none
                        "background-color:#ffffff;color:#0f172a;"
                      else
                        "background-color:transparent;color:#cbd5e1;"
                      end

                    cell_style +=
                      if !cell.in_month
                        "border:1px solid transparent;"
                      elsif cell.off_day
                        "border:3px solid #7c3aed;"
                      else
                        "border:1px solid #cbd5e1;"
                      end

                    if cell.selected
                      cell_style += "box-shadow:inset 0 0 0 2px #0f172a;"
                    end
                  %>
                  <td class="p-0.5 align-middle">
                    <% if cell.in_month %>
                      <%= link_to daily_routine_path(date: cell.date.iso8601, month: @calendar.month.strftime("%Y-%m")),
                            class: "mx-auto flex h-10 w-full items-center justify-center rounded-lg text-sm font-bold no-underline",
                            style: cell_style,
                            data: { routine_link: true },
                            aria: { current: (cell.selected ? "date" : false), label: "#{cell.date.strftime("%Y/%m/%d")} #{cell.status}#{cell.off_day ? ' 休み' : ''}" } do %>
                        <%= cell.date.day %>
                      <% end %>
                    <% else %>
                      <span class="mx-auto flex h-10 w-full items-center justify-center text-sm" style="color:#cbd5e1;"><%= cell.date.day %></span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
