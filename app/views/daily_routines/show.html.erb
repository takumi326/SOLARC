<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h2 class="text-xl font-bold leading-none">ルーチン</h2>
        <span class="text-base font-bold leading-none text-slate-800" style="font-family:inherit;"><%= @date.strftime("%Y/%m/%d") %>（<%= %w[日 月 火 水 木 金 土][@date.wday] %>）</span>
        <% if @off_day %>
          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-bold text-white" style="background-color:#7c3aed;">休日</span>
        <% else %>
          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-bold text-white" style="background-color:#2563eb;">平日</span>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "項目を編集", daily_routine_settings_path, class: btn_classes(:secondary) %>
      </div>
    </div>

    <% visible_slots = @slots.select(&:emphasized) %>
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
      <% visible_slots.each do |slot| %>
        <%
          holiday_slot = slot.slot == "holiday"
          card_style =
            if slot.completed
              "border:2px solid #059669;background-color:#ecfdf5;"
            elsif holiday_slot
              "border:2px solid #7c3aed;background-color:#f5f3ff;"
            else
              "border:2px solid #2563eb;background-color:#eff6ff;"
            end
          status_style =
            if slot.completed
              "background-color:#059669;color:#ffffff;"
            elsif holiday_slot
              "background-color:#7c3aed;color:#ffffff;"
            else
              "background-color:#e11d48;color:#ffffff;"
            end
          condition_style =
            if slot.completed
              "background-color:#ffffff;color:#065f46;border:1px solid #059669;"
            elsif holiday_slot
              "background-color:#ffffff;color:#5b21b6;border:1px solid #a78bfa;"
            else
              "background-color:#ffffff;color:#0f172a;border:1px solid #64748b;"
            end
        %>
        <article class="overflow-hidden rounded-xl" style="<%= card_style %>">
          <div class="px-4 py-2 text-center text-sm font-bold tracking-wide" style="<%= status_style %>">
            <% if slot.completed %>
              ✓ 完了
            <% elsif holiday_slot %>
              休日・未完了
            <% else %>
              未完了
            <% end %>
          </div>

          <div class="p-4">
            <div class="mb-3 flex flex-wrap items-center gap-2">
              <h3 class="text-lg font-bold text-slate-900"><%= slot.label %></h3>
              <% if holiday_slot %>
                <span class="rounded-md px-2 py-0.5 text-xs font-bold" style="background-color:#ddd6fe;color:#5b21b6;">休みの日用</span>
              <% end %>
            </div>

            <p class="mb-3 rounded-lg px-3 py-2 text-sm font-medium leading-relaxed" style="<%= condition_style %>">
              完了条件：<%= slot.completion_hint %>
            </p>

            <ol class="space-y-2 text-sm text-slate-800">
              <% slot.items.each_with_index do |item, index| %>
                <li class="leading-relaxed">
                  <span class="font-semibold text-slate-500"><%= index + 1 %>.</span>
                  <%= item.label %>
                </li>
              <% end %>
            </ol>

            <div class="mt-4">
              <% if slot.completed %>
                <p class="text-sm font-semibold" style="color:#047857;">この枠は完了済みです</p>
              <% elsif holiday_slot %>
                <%= link_to "エントリーを登録して完了にする →", new_entry_path, class: btn_classes(:primary) %>
              <% else %>
                <%= link_to "毎日の記録を書いて完了にする →", stock_daily_notes_path, class: btn_classes(:primary) %>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 sm:p-4">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
        <%= form_with url: daily_routine_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2" do %>
          <div>
            <label for="routine_date" class="mb-1 block text-xs font-medium text-slate-600">日付を選ぶ</label>
            <input id="routine_date" type="date" name="date" value="<%= @date.iso8601 %>" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" onchange="this.form.requestSubmit()" />
          </div>
          <%= link_to "今日", daily_routine_path, class: btn_classes(:primary) %>
        <% end %>

        <div class="flex flex-wrap items-center gap-2">
          <% if @weekend %>
            <span class="inline-flex items-center rounded-lg border border-slate-300 bg-slate-100 px-3 py-1.5 text-sm text-slate-600">土日は休み</span>
          <% elsif @marked_off %>
            <%= button_to "休みを解除", off_days_daily_routine_path(date: @date.iso8601), method: :delete, class: btn_classes(:secondary) %>
          <% else %>
            <%= button_to "この日を休みにする", off_days_daily_routine_path(date: @date.iso8601), method: :post, class: btn_classes(:secondary) %>
          <% end %>
        </div>
      </div>

      <div class="mb-2 flex items-center justify-between gap-2">
        <%= link_to "←", daily_routine_path(date: @date.iso8601, month: @calendar.prev_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
        <p class="text-sm font-semibold text-slate-800"><%= @calendar.month.strftime("%Y年%-m月") %></p>
        <%= link_to "→", daily_routine_path(date: @date.iso8601, month: @calendar.next_month.strftime("%Y-%m")), class: btn_classes(:secondary) %>
      </div>

      <table class="w-full table-fixed border-collapse text-center text-sm">
        <thead>
          <tr class="text-xs font-medium text-slate-500">
            <% %w[日 月 火 水 木 金 土].each do |wday| %>
              <th scope="col" class="px-0.5 py-1 font-medium"><%= wday %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @calendar.weeks.each do |week| %>
            <tr>
              <% week.each do |cell| %>
                <%
                  # 背景 = 完了状態 / 紫の太枠 = 休み
                  cell_style =
                    case cell.status
                    when :complete
                      "background-color:#059669;color:#ffffff;"
                    when :partial
                      "background-color:#f59e0b;color:#ffffff;"
                    when :incomplete, :none
                      "background-color:#ffffff;color:#0f172a;"
                    else
                      "background-color:transparent;color:#cbd5e1;"
                    end

                  cell_style +=
                    if !cell.in_month
                      "border:1px solid transparent;"
                    elsif cell.off_day
                      "border:3px solid #7c3aed;"
                    else
                      "border:1px solid #cbd5e1;"
                    end

                  if cell.selected
                    cell_style += "box-shadow:inset 0 0 0 2px #0f172a;"
                  end
                %>
                <td class="p-0.5 align-middle">
                  <% if cell.in_month %>
                    <%= link_to daily_routine_path(date: cell.date.iso8601, month: @calendar.month.strftime("%Y-%m")),
                          class: "mx-auto flex h-10 w-full items-center justify-center rounded-lg text-sm font-bold no-underline",
                          style: cell_style,
                          aria: { current: (cell.selected ? "date" : false), label: "#{cell.date.strftime("%Y/%m/%d")} #{cell.status}#{cell.off_day ? ' 休み' : ''}" } do %>
                      <%= cell.date.day %>
                    <% end %>
                  <% else %>
                    <span class="mx-auto flex h-10 w-full items-center justify-center text-sm" style="color:#cbd5e1;"><%= cell.date.day %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="mt-3 space-y-2 text-xs text-slate-700">
        <div class="flex flex-wrap items-center gap-4">
          <span class="font-semibold text-slate-500">背景</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold text-white" style="background-color:#059669;border:1px solid #cbd5e1;">1</span>完了
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold text-white" style="background-color:#f59e0b;border:1px solid #cbd5e1;">2</span>一部
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold" style="background-color:#ffffff;border:1px solid #cbd5e1;color:#0f172a;">3</span>未完了
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <span class="font-semibold text-slate-500">枠線</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold" style="background-color:#ffffff;border:3px solid #7c3aed;color:#0f172a;">4</span>休み
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold text-white" style="background-color:#059669;border:3px solid #7c3aed;">5</span>休みで完了
          </span>
        </div>
      </div>
    </div>
  </section>
</div>
