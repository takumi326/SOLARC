<div class="mx-auto max-w-2xl space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">ライン変更を記録</h2>
    <% if @stock %>
      <p class="mt-1 text-sm text-slate-600"><%= @stock.code %> <%= @stock.name %></p>
    <% end %>
    <%= render "form",
               record: @line_change,
               stock: @stock,
               trade_type: @trade_type,
               judgment_type: @judgment_type,
               ai_script_id: @ai_script_id,
               ai_scripts: @ai_scripts,
               form_url: line_changes_path,
               form_method: :post,
               submit_label: "記録" %>
  </section>
</div>
