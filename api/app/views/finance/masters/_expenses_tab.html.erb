<% filter = params[:filter].presence_in(%w[one_time recurring]) || "one_time" %>
<% expenses = Expense.joins(:minor_category).preload(:minor_category, :payment_method).order("minor_categories.name ASC, expenses.id ASC").select { |e| e.expense_type == filter } %>
<% minors = MinorCategory.joins(:major_category).includes(:major_category).index_by(&:id) %>
<% by_major = expenses.group_by { |e| minors[e.minor_category_id]&.major_category&.name || "—" }.sort_by { |name, _| name } %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-3 flex items-center justify-between">
    <h3 class="text-lg font-semibold">支出</h3>
    <%= link_to "＋ 実績を追加", new_finance_masters_expense_path(expense_type: filter), class: btn_classes(:primary) %>
  </div>

  <div class="mb-3 inline-flex rounded-full bg-slate-100 p-0.5 text-xs">
    <%= link_to "単発", finance_masters_path(tab: "expenses", filter: "one_time"), class: breakdown_tab_class(filter == "one_time") %>
    <%= link_to "定期", finance_masters_path(tab: "expenses", filter: "recurring"), class: breakdown_tab_class(filter == "recurring") %>
  </div>

  <% if expenses.empty? %>
    <p class="text-sm text-slate-500">条件に一致する支出がありません</p>
  <% else %>
    <ul class="space-y-2">
      <% by_major.each do |major_name, rows| %>
        <li class="rounded-lg border border-slate-200">
          <details open>
            <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2 text-sm">
              <span class="font-medium"><%= major_name %></span>
              <span class="text-xs text-slate-500"><%= rows.size %>件</span>
            </summary>
            <div class="overflow-x-auto border-t border-slate-100">
              <table class="min-w-[820px] divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-xs text-slate-500">
                  <tr>
                    <th class="px-3 py-2">小カテゴリ</th><th class="px-3 py-2">種別</th><th class="px-3 py-2">金額</th><th class="px-3 py-2">支払方法</th><th class="px-3 py-2">月</th><th class="px-3 py-2"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% rows.each do |row| %>
                    <tr>
                      <td class="px-3 py-2"><%= minors[row.minor_category_id]&.name %></td>
                      <td class="px-3 py-2"><%= recurring_type_label(row.expense_type) %></td>
                      <td class="px-3 py-2"><%= format_yen(row.amount) %></td>
                      <td class="px-3 py-2"><%= row.payment_method.name %></td>
                      <td class="px-3 py-2"><%= format_month_label(row.start_month) %></td>
                      <td class="px-3 py-2">
                        <div class="flex gap-1">
                          <%= link_to "詳細", finance_expense_actuals_path(row), class: btn_classes(:link, extra: "px-2 py-1 text-xs") %>
                          <%= link_to "編集", edit_finance_masters_expense_path(row), class: btn_classes(:secondary, extra: "px-2 py-1 text-xs") %>
                          <%= button_to "削除", finance_masters_expense_path(row), method: :delete, form: { data: { turbo_confirm: "マスタと紐づく実績も削除されます。よろしいですか？" } }, class: btn_classes(:danger, extra: "px-2 py-1 text-xs") %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
