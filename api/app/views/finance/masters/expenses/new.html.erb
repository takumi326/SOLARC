<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold"><%= @expense.new_record? ? "支出を追加" : "支出を編集" %></h2>
    <%= form_with model: @expense, url: @expense.persisted? ? finance_masters_expense_path(@expense) : finance_masters_expenses_path, class: "mt-4 space-y-3" do |form| %>
      <label class="block text-sm">カテゴリ <%= form.collection_select :minor_category_id, @expense_minors, :id, ->(m) { "#{m.major_category.name} / #{m.name}" }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">支払方法 <%= form.collection_select :payment_method_id, @payment_methods, :id, :name, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">種別 <%= form.select :expense_type, [["単発", "one_time"], ["定期", "recurring"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">周期 <%= form.select :recurring_cycle, [["月次", "monthly"], ["年次", "yearly"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">更新月（年次） <%= form.number_field :renewal_month, in: 1..12, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">金額 <%= form.number_field :amount, min: 0, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm", required: true %></label>
      <label class="block text-sm">開始月 <%= form.month_field :start_month, value: format_month_input(@expense.start_month || Date.current), class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">終了月 <%= form.month_field :end_month, value: (@expense.end_month ? format_month_input(@expense.end_month) : nil), class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <label class="block text-sm">メモ <%= form.text_area :memo, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></label>
      <div class="flex gap-2">
        <%= link_to "キャンセル", finance_masters_path(tab: "expenses"), class: btn_classes(:secondary) %>
        <%= form.submit "保存", class: btn_classes(:primary, extra: "cursor-pointer") %>
      </div>
    <% end %>
  </section>
</div>
