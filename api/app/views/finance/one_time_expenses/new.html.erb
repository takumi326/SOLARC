<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-bold">単発の支出を追加</h2>
      <%= link_to "キャンセル", finance_summary_path(month: @month_input), class: btn_classes(:secondary) %>
    </div>

    <%= form_with model: @expense, url: finance_one_time_expenses_path, class: "space-y-3" do |form| %>
      <label class="block text-sm">
        <span class="text-slate-600">カテゴリ（小）</span>
        <select name="expense[minor_category_id]" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" required>
          <option value="">カテゴリを選択</option>
          <% @expense_minors.each do |minor| %>
            <option value="<%= minor.id %>"><%= minor.major_category.name %> / <%= minor.name %></option>
          <% end %>
        </select>
      </label>

      <label class="block text-sm">
        <span class="text-slate-600">支払方法</span>
        <select name="expense[payment_method_id]" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" required>
          <% @payment_methods.each do |method| %>
            <option value="<%= method.id %>"><%= method.name %></option>
          <% end %>
        </select>
      </label>

      <label class="block text-sm">
        <span class="text-slate-600">金額</span>
        <input type="number" name="expense[amount]" min="0" step="1" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" required />
      </label>

      <label class="block text-sm">
        <span class="text-slate-600">支払月</span>
        <input type="month" name="expense[start_month]" value="<%= @month_input %>" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" required />
      </label>

      <label class="block text-sm">
        <span class="text-slate-600">メモ（任意）</span>
        <textarea name="expense[memo]" rows="2" maxlength="2000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
      </label>

      <div class="flex justify-end gap-2">
        <%= form.submit "保存", class: btn_classes(:primary, extra: "cursor-pointer") %>
      </div>
    <% end %>
  </section>
</div>
