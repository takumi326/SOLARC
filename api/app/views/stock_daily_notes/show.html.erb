<div class="space-y-4">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-bold"><%= StockDailyPromptBuilder.format_record_date_jp(@note.recorded_on.iso8601) %></h2>
      <%= link_to "一覧に戻る", stock_daily_notes_path, class: btn_secondary_classes %>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-3 lg:grid-cols-3 lg:items-stretch">
    <% [
      ["仮説", @note.hypothesis],
      ["結果", @note.result],
      ["セクター調べ", @note.sector_research]
    ].each do |title, body| %>
      <section class="flex min-h-0 min-w-0 flex-col rounded-xl border border-slate-200 bg-slate-50/40 lg:max-h-[65vh]">
        <h4 class="shrink-0 border-b border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-800"><%= title %></h4>
        <div class="min-h-0 flex-1 overflow-y-auto p-3 <%= body.to_s.strip.present? ? 'bg-white' : '' %>">
          <%= render_stock_daily_markdown(body) %>
        </div>
      </section>
    <% end %>
  </div>
</div>
